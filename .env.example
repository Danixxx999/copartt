# Copiar a .env y ajustar. Nunca subir .env a Git.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# PostgreSQL local (scripts/db.js arranca el servidor portable en el puerto 5433)
DATABASE_URL=postgres://postgres:copart_dev@127.0.0.1:5433/copart
TEST_DATABASE_URL=postgres://postgres:copart_dev@127.0.0.1:5433/copart_test
# Secreto para firmar tokens CSRF. Genera uno propio: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=cambia-este-secreto-por-uno-aleatorio-largo
UPLOAD_DIR=./storage/uploads
# Contraseña común de las cuentas demo creadas por el seed (solo entorno local)
DEMO_PASSWORD=Demo2026!

# ── Pasarela de pagos (ver /admin/payments) ──
# demo = sin dinero real. Para cobrar de verdad: escribir el adaptador en src/services/payments.js y rellenar sus claves.
PAYMENT_PROVIDER=demo
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ── Inicio de sesión social (ver /admin/social-login) ──
# Vacío = botón desactivado. Rellénelos para activar "Continuar con Google / Microsoft".
OAUTH_BASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
