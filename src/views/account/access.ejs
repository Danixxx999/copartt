<%- include('../partials/account-start') %>
<h1><%= t('Claves de acceso') %></h1>
<p class="acc-lead"><%= ht('Controle cómo y desde dónde se accede a su cuenta. Su contraseña se guarda cifrada con Argon2id; nadie del equipo puede verla.', 'Control how and where your account is accessed. Your password is stored hashed with Argon2id; nobody on the team can see it.') %></p>
<section class="acc-card acc-row-card"><div><strong><%= t('Contraseña') %></strong><p class="acc-muted"><%= t('Última actualización el') %> <%= date(profile.password_changed_at || profile.member_since) %></p></div><a class="btn btn-blue" href="/account/personal-information"><%= t('Actualizar') %></a></section>
<section class="acc-card acc-row-card"><div><strong><%= ht('Llaves de acceso (passkeys)', 'Passkeys') %></strong><p class="acc-muted"><%= ht('Próximamente: iniciar sesión con la huella o el rostro de su dispositivo.', 'Coming soon: sign in with your device fingerprint or face.') %></p></div><span class="acc-tag"><%= ht('No disponible', 'Not available') %></span></section>
<div class="acc-headrow"><h2 class="acc-h2 big"><%= ht('Sesiones activas', 'Active sessions') %> (<%= sessions.length %>)</h2><% if (sessions.length > 1) { %><button class="btn btn-outline btn-sm" type="button" data-api="/api/v1/account/sessions/revoke-others" data-confirm="<%= ht('¿Cerrar la sesión en todos los demás dispositivos?', 'Sign out of all other devices?') %>"><%= ht('Cerrar las demás sesiones', 'Sign out other sessions') %></button><% } %></div>
<div class="acc-list"><% sessions.forEach(function (s) { %><div class="acc-item"><svg class="ic" aria-hidden="true"><use href="#i-shield"/></svg><div><strong><%= (s.user_agent || '').match(/Edg|Chrome|Firefox|Safari/) ? (s.user_agent.match(/Edg/) ? 'Edge' : s.user_agent.match(/Chrome/) ? 'Chrome' : s.user_agent.match(/Firefox/) ? 'Firefox' : 'Safari') : ht('Dispositivo', 'Device') %></strong> <% if (s.current) { %><span class="acc-tag"><%= ht('Esta sesión', 'This session') %></span><% } %><br><span class="acc-muted"><%= s.ip %> · <%= ht('desde', 'since') %> <%= dateTime(s.created_at) %> · <%= ht('caduca', 'expires') %> <%= date(s.expires_at) %></span></div><span class="acc-spacer"></span><% if (!s.current) { %><button class="link-btn danger" type="button" data-api="/api/v1/account/sessions/<%= s.id %>" data-method="DELETE"><%= ht('Cerrar', 'Sign out') %></button><% } %></div><% }) %></div>
<%- include('../partials/account-end') %>
