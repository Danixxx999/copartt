<%- include('../partials/account-start') %>
<% var memberNo = String(user.id).padStart(6, '0'); var countryName2 = function (c) { return regions[c] || c; }; %>
<h1><%= t('Información personal') %></h1>
<section class="acc-card acc-member">
  <span class="acc-avatar" aria-hidden="true"><svg class="ic"><use href="#i-user"/></svg></span>
  <div class="acc-member-info">
    <h2><%= t('Membresía') %></h2>
    <p><%= user.plan ? user.plan.name : t('invitado') %>: <%= memberNo %> <button type="button" class="copy-btn" data-copy="<%= memberNo %>" aria-label="<%= t('Copiar número de miembro') %>"><svg class="ic"><use href="#i-file"/></svg></button><% if (user.plan && user.plan.subscription_ends_at) { %> <span class="sep">|</span> <%= t('Se renueva automáticamente el') %> <%= date(user.plan.subscription_ends_at) %><% } %></p>
    <p><%= t('Método de pago') %> <% if (card) { %><span class="card-brand brand-<%= card.brand %>"><%= card.brand.toUpperCase() %></span> ··· <%= card.last4 %><% } else { %><a href="/account/payment-methods"><%= t('Añadir nuevo método de pago') %></a><% } %></p>
  </div>
  <div class="acc-member-actions"><a href="/dashboard/membership"><%= t('Actualizar') %></a><a href="/account/payment-methods"><%= t('Gestionar pago automático') %></a></div>
</section>

<div class="acc-rows">
  <div class="acc-row"><div><h3><%= t('Nombre') %></h3><p><%= (profile.first_name + ' ' + profile.last_name).toUpperCase() %></p></div><a href="/dashboard/profile"><%= t('Editar') %></a></div>
  <div class="acc-row"><div><h3><%= t('Títulos de vehículos emitidos a') %></h3><p><%= (profile.title_name || (profile.company_name || profile.first_name + ' ' + profile.last_name)).toUpperCase() %></p></div><button type="button" data-open-dialog="dlg-title"><%= t('Editar') %></button></div>
  <div class="acc-row"><div><h3><%= t('Número de teléfono') %></h3><p><span class="acc-k"><%= t('Principal') %>:</span> <%= profile.phone ? profile.phone_prefix + ' ' + profile.phone : '—' %></p></div><button type="button" data-open-dialog="dlg-phone"><%= t('Editar') %></button></div>
  <div class="acc-row"><div><h3><%= t('Correo electrónico') %></h3><p><%= profile.email %></p></div><button type="button" data-open-dialog="dlg-email" <%= impersonator ? 'disabled' : '' %>><%= t('Editar') %></button></div>
  <div class="acc-row"><div><h3><%= t('Contraseña') %></h3><p><%= t('Última actualización el') %> <%= date(profile.password_changed_at || profile.member_since) %></p></div><button type="button" data-open-dialog="dlg-pw" <%= impersonator ? 'disabled' : '' %>><%= t('Actualizar') %></button></div>
  <div class="acc-row"><div><h3><%= t('Dirección física') %></h3><p><%= profile.address ? [profile.address, profile.city, profile.postal_code, countryName2(profile.country)].filter(Boolean).join(', ') : '—' %></p></div><button type="button" data-open-dialog="dlg-phys"><%= t('Editar') %></button></div>
  <div class="acc-row"><div><h3><%= t('Dirección postal') %></h3><p><%= profile.mail_address ? [profile.mail_address, profile.mail_city, profile.mail_postal_code, countryName2(profile.mail_country)].join(', ') : t('Igual que la dirección física') %></p></div><button type="button" data-open-dialog="dlg-mail"><%= t('Editar') %></button></div>
</div>

<dialog id="dlg-title"><div class="dlg"><h2><%= t('Títulos de vehículos emitidos a') %></h2><form data-api="/api/v1/account/title-name" data-method="PATCH" novalidate><div class="form-row"><label for="tn"><%= t('Nombre') %></label><input id="tn" name="title_name" value="<%= profile.title_name || (profile.company_name || profile.first_name + ' ' + profile.last_name) %>" required></div><div class="dlg-actions"><button class="btn btn-light" type="button" data-close><%= t('Cerrar') %></button><button class="btn btn-blue" type="submit"><%= t('Guardar') %></button></div></form></div></dialog>
<dialog id="dlg-phone"><div class="dlg"><h2><%= t('Número de teléfono') %></h2><form data-api="/api/v1/account/phone" data-method="PATCH" novalidate><div class="form-grid"><div class="form-row"><label for="pp"><%= t('Prefijo') %></label><input id="pp" name="phone_prefix" value="<%= profile.phone_prefix %>"></div><div class="form-row"><label for="ph"><%= t('Número de teléfono') %></label><input id="ph" name="phone" inputmode="numeric" value="<%= profile.phone %>"></div></div><div class="dlg-actions"><button class="btn btn-light" type="button" data-close><%= t('Cerrar') %></button><button class="btn btn-blue" type="submit"><%= t('Guardar') %></button></div></form></div></dialog>
<dialog id="dlg-email"><div class="dlg"><h2><%= t('Correo electrónico') %></h2><form data-api="/api/v1/account/email" data-method="PATCH" novalidate><div class="form-row"><label for="em"><%= t('Nuevo correo electrónico') %></label><input id="em" name="email" type="email" value="<%= profile.email %>" required></div><div class="form-row"><label for="emp"><%= t('Contraseña actual') %></label><input id="emp" name="current_password" type="password" autocomplete="current-password" required></div><div class="dlg-actions"><button class="btn btn-light" type="button" data-close><%= t('Cerrar') %></button><button class="btn btn-blue" type="submit"><%= t('Guardar') %></button></div></form></div></dialog>
<dialog id="dlg-pw"><div class="dlg"><h2><%= t('Contraseña') %></h2><form data-api="/api/v1/account/password" data-reset novalidate><div class="form-row"><label for="op"><%= t('Contraseña actual') %></label><input id="op" name="current_password" type="password" autocomplete="current-password" required></div><div class="form-row"><label for="np"><%= t('Nueva contraseña') %></label><input id="np" name="new_password" type="password" autocomplete="new-password" required><span class="hint"><%= ht('Mínimo 10 caracteres, con letras y números.', 'At least 10 characters, letters and numbers.') %></span></div><div class="dlg-actions"><button class="btn btn-light" type="button" data-close><%= t('Cerrar') %></button><button class="btn btn-blue" type="submit"><%= t('Actualizar') %></button></div></form></div></dialog>
<% [['dlg-phys', 'physical', t('Dirección física'), profile.address, profile.city, profile.postal_code, profile.country], ['dlg-mail', 'mailing', t('Dirección postal'), profile.mail_address || profile.address, profile.mail_city || profile.city, profile.mail_postal_code || profile.postal_code, profile.mail_country || profile.country]].forEach(function (a) { %>
<dialog id="<%= a[0] %>"><div class="dlg"><h2><%= a[2] %></h2><form data-api="/api/v1/account/address/<%= a[1] %>" data-method="PATCH" novalidate>
  <div class="form-row"><label for="<%= a[0] %>-a"><%= t('Línea 1 de dirección') %></label><input id="<%= a[0] %>-a" name="address" value="<%= a[3] %>" required></div>
  <div class="form-grid"><div class="form-row"><label for="<%= a[0] %>-c"><%= t('Ciudad') %></label><input id="<%= a[0] %>-c" name="city" value="<%= a[4] %>" required></div><div class="form-row"><label for="<%= a[0] %>-p"><%= t('Código postal') %></label><input id="<%= a[0] %>-p" name="postal_code" value="<%= a[5] %>" required></div>
  <div class="form-row"><label for="<%= a[0] %>-k"><%= t('País') %></label><select id="<%= a[0] %>-k" name="country"><% Object.keys(regions).forEach(function (c) { %><option value="<%= c %>" <%= a[6] === c ? 'selected' : '' %>><%= regions[c] %></option><% }) %><option value="CO" <%= a[6] === 'CO' ? 'selected' : '' %>>COLOMBIA</option></select></div></div>
  <div class="dlg-actions"><button class="btn btn-light" type="button" data-close><%= t('Cerrar') %></button><button class="btn btn-blue" type="submit"><%= t('Guardar') %></button></div></form></div></dialog>
<% }) %>
<%- include('../partials/account-end') %>
