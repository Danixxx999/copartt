<%- include('../../partials/panel-start') %>
<div class="m-head"><div><h1 class="m-title">Sales &amp; Approvals</h1><p class="lead">Results of your lots. When the highest bid is below your reserve you decide: accept it, reject it or send the high bidder a counter offer.</p></div></div>
<% var pending = rows.filter(function (l) { return l.status === 'pending_seller_approval'; }); %>
<% if (pending.length) { %>
<section class="widget"><div class="w-hd"><h2><svg class="ic"><use href="#i-swap"/></svg>Awaiting your decision (<%= pending.length %>)</h2></div><div class="w-bd w-flush"><div class="table-wrap"><table class="tbl"><thead><tr><th>Lot</th><th>Vehicle</th><th class="num">High bid</th><th class="num">Your reserve</th><th>Counter offer</th><th>Decision</th></tr></thead><tbody>
<% pending.forEach(function (l) { %><tr><td><a href="/lot/<%= l.lot_number %>">#<%= l.lot_number %></a></td><td><%= l.year %> <%= l.make %> <%= l.model %></td><td class="num"><strong><%= eur(l.current_bid_cents) %></strong></td><td class="num"><%= eur(l.reserve_cents) %></td>
  <td><% if (l.counter_offer_cents) { %><span class="badge badge-blue">Sent <%= eur(l.counter_offer_cents) %></span><br><span class="hint">Waiting for the buyer · <%= dateTime(l.counter_offer_at) %></span><% } else { %>
    <form class="inline-form" data-api="/api/v1/seller/lots/<%= l.id %>/counter" data-confirm="Send this counter offer to the high bidder?" novalidate><label class="sr-only" for="co-<%= l.id %>">Counter offer (€)</label><input id="co-<%= l.id %>" name="amount" type="number" min="<%= (l.current_bid_cents + 2500) / 100 %>" max="<%= l.reserve_cents / 100 %>" step="25" value="<%= Math.round((l.current_bid_cents + l.reserve_cents) / 2 / 2500) * 25 %>" required><button class="btn btn-blue btn-sm" type="submit">Counter</button></form><% } %></td>
  <td class="actions"><button class="btn btn-green btn-sm" type="button" data-api="/api/v1/seller/lots/<%= l.id %>/decision" data-body='{"accept":true}' data-confirm="Accept the high bid of <%= eur(l.current_bid_cents) %>?">Accept bid</button><button class="btn btn-red btn-sm" type="button" data-api="/api/v1/seller/lots/<%= l.id %>/decision" data-body='{"accept":false}' data-confirm="Reject this bid? The vehicle returns to your inventory.">Reject</button></td></tr><% }) %>
</tbody></table></div></div></section>
<% } %>
<section class="widget"><div class="w-hd"><h2><svg class="ic"><use href="#i-gavel"/></svg>All lots</h2></div><div class="w-bd w-flush"><% if (!rows.length) { %><div class="empty">No lots yet.</div><% } else { %>
<div class="table-wrap"><table class="tbl"><thead><tr><th>Lot</th><th>Vehicle</th><th>Auction</th><th class="num">Bids</th><th class="num">Highest / sale</th><th class="num">Reserve</th><th class="num">Buy It Now</th><th>Status</th><th>Order</th></tr></thead><tbody>
<% rows.forEach(function (l) { %><tr><td><a href="/lot/<%= l.lot_number %>">#<%= l.lot_number %></a></td><td><%= l.year %> <%= l.make %> <%= l.model %></td><td><%= l.event_name %><br><span class="hint"><%= dateTime(l.starts_at) %></span></td><td class="num"><%= l.bid_count %></td><td class="num"><%= eur(l.current_bid_cents) %></td><td class="num"><%= eur(l.reserve_cents) %></td><td class="num"><%= l.buy_now_cents ? eur(l.buy_now_cents) : '—' %></td><td><%- badge(l.status) %><% if (l.sold_via) { %><br><span class="hint">via <%= String(l.sold_via).replace(/_/g, ' ') %></span><% } %></td><td><%= l.order_number || '—' %><% if (l.order_status) { %><br><%- badge(l.order_status) %><% } %></td></tr><% }) %>
</tbody></table></div><% } %></div></section>
<%- include('../../partials/panel-end') %>
