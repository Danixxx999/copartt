<%- include('../../partials/panel-start') %>
<div class="m-head"><div><h1 class="m-title">Mis Lotes</h1><p>Filtros aplicados: &nbsp; No se aplicó ningún filtro</p></div><button class="btn btn-outline" type="button" data-print>Imprimir</button></div>
<% var columns=['Imágenes','Número de lote','Año','Marca','Modelo','Artículo','Ubicación / Carril / Fila','Fecha de venta','Odómetro','Documento','Valor minorista estimado','Estado de la oferta','Estado del Lote']; %>
<div class="table-actions"><button type="button" data-export-table>☁ Exportar</button><details class="column-picker"><summary>Personalizar Ver</summary><div><% columns.forEach(function(h,i){ %><label><input type="checkbox" data-column-index="<%= i %>" checked><%= h %></label><% }) %></div></details><button type="button" data-toggle-images>Ocultar imágenes</button><button type="button" data-text-size>Tamaño del texto A+</button></div>
<div class="data-table" data-table><%- include('../../partials/table-tools', { count: items.length }) %><div class="table-wrap"><table class="tbl"><thead><tr><% columns.forEach(function(h){ %><th><%= h %></th><% }) %></tr></thead><tbody><% items.forEach(function(r){ %><tr><td><img class="mini-img" src="<%= r.image %>" alt=""></td><td><a href="/lot/<%= r.lot_number %>"><%= r.lot_number %></a></td><td><%= r.year %></td><td><%= r.make %></td><td><%= r.model %></td><td><%= r.sequence %></td><td><%= r.location_name %></td><td><%= dateTime(r.auction_date) %></td><td><%= km(r.odometer_km) %></td><td><%= r.document_type %></td><td><%= eur(r.estimated_value_cents) %></td><td><%= r.leading ? 'Ganando' : 'Superada' %></td><td><%- badge(r.status) %></td></tr><% }) %><% if(!items.length) { %><tr><td colspan="13" class="empty-cell">No tiene Mis Lotes. Comience una nueva búsqueda utilizando el <a href="/vehicle-finder">Buscador de Vehículos</a>.</td></tr><% } %></tbody></table></div><%- include('../../partials/table-tools', { count: items.length }) %></div>
<%- include('../../partials/panel-end') %>
