<%- include('../../partials/panel-start') %>
<div class="m-head"><div><h1 class="m-title">Purchases &amp; Pickup</h1><p class="lead">Vehicles you won or bought. Pay the invoice, then collect it at the yard with your PIN or request transport.</p></div></div>
<ol class="steps-line" aria-label="Purchase steps"><li>Won</li><li>Pay invoice</li><li>Finance validates</li><li>Pickup PIN / transport</li><li>Completed</li></ol>
<div class="widget"><div class="w-bd w-flush"><% if (!orders.length) { %><div class="empty">You haven't won any vehicle yet. <a href="/auctions">Join an auction</a>.</div><% } else { %>
<div class="table-wrap"><table class="tbl"><thead><tr><th></th><th>Order</th><th>Vehicle</th><th>Yard</th><th class="num">Sale price</th><th class="num">Balance</th><th>Status</th><th></th></tr></thead><tbody>
<% orders.forEach(function (o) { %><tr><td><img class="mini-img" src="<%= o.image %>" alt=""></td><td><strong><%= o.order_number %></strong><br><span class="hint">Lot #<%= o.lot_number %> · <%= date(o.created_at) %></span></td><td><%= o.year %> <%= o.make %> <%= o.model %><br><span class="hint"><%= o.sold_via === 'buy_now' ? 'Buy It Now' : o.sold_via === 'counter_offer' ? 'Counter offer' : o.sold_via === 'seller_approval' ? 'Seller approval' : 'Auction' %></span></td><td><%= o.location_name %></td><td class="num"><%= eur(o.hammer_cents) %></td><td class="num"><% if (o.balance) { %><strong class="txt-warn"><%= eur(o.balance) %></strong><br><span class="hint">due <%= date(o.due_at) %></span><% } else { %>—<% } %></td><td><%- badge(o.status) %></td><td><a class="btn <%= o.status === 'pending_payment' ? 'btn-green' : 'btn-blue' %> btn-sm" href="/dashboard/purchases/<%= o.id %>"><%= o.status === 'pending_payment' ? 'Pay now' : 'Open' %></a></td></tr><% }) %>
</tbody></table></div><% } %></div></div>
<%- include('../../partials/panel-end') %>
