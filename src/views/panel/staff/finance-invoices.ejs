<%- include('../../partials/panel-start') %>
<h1>Invoices</h1><p class="lead">Unique sequential numbering (INV-YYYY-NNNNNN). PDF generated on demand.</p>
<div class="filters-bar"><% ['all','issued','partially_paid','paid','void'].forEach(function (s) { %><a class="chip <%= status === s ? 'on' : '' %>" href="?status=<%= s %>"><%= s === 'all' ? 'All' : label(s) %></a><% }) %><a class="btn btn-light btn-sm" href="/api/v1/reports/invoices.csv">Export CSV</a></div>
<div class="p-card"><div class="table-wrap"><table class="tbl"><thead><tr><th>Number</th><th>Type</th><th>Customer</th><th>Order</th><th>Issued</th><th>Due</th><th class="num">Total</th><th class="num">Paid</th><th>Status</th><th></th></tr></thead><tbody>
<% rows.forEach(function (i) { var overdue = ['issued','partially_paid'].includes(i.status) && new Date(i.due_at) < new Date(); %><tr><td><strong><%= i.invoice_number %></strong></td><td><%= i.kind %></td><td><%= i.email %></td><td><%= i.order_number || '—' %><% if (i.order_status) { %><br><%- badge(i.order_status) %><% } %></td><td><%= date(i.issued_at) %></td><td style="<%= overdue ? 'color:#b91c1c;font-weight:700' : '' %>"><%= date(i.due_at) %><%= overdue ? ' (overdue)' : '' %></td><td class="num"><%= eur(i.total_cents) %></td><td class="num"><%= eur(i.paid_cents) %></td><td><%- badge(i.status) %></td>
<td class="actions"><a class="btn btn-light btn-sm" href="/dashboard/invoices/<%= i.id %>.pdf" target="_blank" rel="noopener">PDF</a><% if (i.order_id && ['pending_payment','payment_review'].includes(i.order_status) && i.kind === 'purchase') { %><button class="btn btn-red btn-sm" type="button" data-api="/api/v1/orders/<%= i.order_id %>/cancel" data-prompt="Reason for cancelling the order (non-payment, etc.):">Cancel order</button><% } %></td></tr><% }) %>
</tbody></table></div></div>
<%- include('../../partials/panel-end') %>
