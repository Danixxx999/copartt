<%- include('../../partials/panel-start') %>
<h1>Monitor de pujas</h1><p class="lead">Cada puja se guarda con fecha, tipo y máximo privado (visible solo para el personal). <a href="/api/v1/reports/bids.csv">Exportar CSV</a></p>
<% if (live.length) { %><section class="p-card" style="border-left:4px solid var(--green)"><h2>En vivo ahora</h2><table class="tbl"><tbody><% live.forEach(function (l) { %><tr><td>#<%= l.lot_number %> · <%= l.year %> <%= l.make %> <%= l.model %></td><td><%= l.event_name %></td><td class="num"><%= eur(l.current_bid_cents) %></td><td>cierra <%= time(l.ends_at) %></td><td><a href="/auctions/<%= l.event_id %>/live">Sala</a></td></tr><% }) %></tbody></table></section><% } %>
<div class="p-card"><div class="table-wrap"><table class="tbl"><thead><tr><th>ID</th><th>Hora</th><th>Lote</th><th>Postor</th><th>Tipo</th><th class="num">Precio</th><th class="num">Máx. (privado)</th><th>Estado del lote</th></tr></thead><tbody>
<% rows.forEach(function (b) { %><tr><td><%= b.id %></td><td class="hint nowrap"><%= dateTime(b.created_at) %></td><td><a href="/lot/<%= b.lot_number %>">#<%= b.lot_number %></a></td><td><%= b.email %></td><td><%= b.kind %></td><td class="num"><%= eur(b.amount_cents) %></td><td class="num"><%= b.max_cents ? eur(b.max_cents) : '—' %></td><td><%- badge(b.lot_status) %></td></tr><% }) %>
</tbody></table></div></div>
<%- include('../../partials/panel-end') %>
