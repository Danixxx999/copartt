<%- include('../../partials/panel-start') %>
<h1>Bid monitor</h1><p class="lead">Every bid is stored with timestamp, kind and private maximum (visible to staff only). <a href="/api/v1/reports/bids.csv">Export CSV</a></p>
<% if (live.length) { %><section class="p-card" style="border-left:4px solid var(--green)"><h2>Live now</h2><table class="tbl"><tbody><% live.forEach(function (l) { %><tr><td>#<%= l.lot_number %> · <%= l.year %> <%= l.make %> <%= l.model %></td><td><%= l.event_name %></td><td class="num"><%= eur(l.current_bid_cents) %></td><td>closes <%= time(l.ends_at) %></td><td><a href="/auctions/<%= l.event_id %>/live">Room</a></td></tr><% }) %></tbody></table></section><% } %>
<div class="p-card"><div class="table-wrap"><table class="tbl"><thead><tr><th>ID</th><th>Time</th><th>Lot</th><th>Bidder</th><th>Kind</th><th class="num">Price</th><th class="num">Max (private)</th><th>Lot status</th></tr></thead><tbody>
<% rows.forEach(function (b) { %><tr><td><%= b.id %></td><td class="hint nowrap"><%= dateTime(b.created_at) %></td><td><a href="/lot/<%= b.lot_number %>">#<%= b.lot_number %></a></td><td><%= b.email %></td><td><%= b.kind %></td><td class="num"><%= eur(b.amount_cents) %></td><td class="num"><%= b.max_cents ? eur(b.max_cents) : '—' %></td><td><%- badge(b.lot_status) %></td></tr><% }) %>
</tbody></table></div></div>
<%- include('../../partials/panel-end') %>
