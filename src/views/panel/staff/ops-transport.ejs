<%- include('../../partials/panel-start') %>
<h1>Órdenes de transporte</h1><p class="lead">Asigna transportistas (solo después de pagar la factura de transporte) y mueve cada envío por recogido → en tránsito → entregado. La entrega completa la compra.</p>
<div class="p-card"><% if (!rows.length) { %><div class="empty">Todavía no hay órdenes de transporte. Los compradores las solicitan desde su página de compra.</div><% } else { %><div class="table-wrap"><table class="tbl"><thead><tr><th>Seguimiento</th><th>Pedido</th><th>Ruta</th><th class="num">Precio</th><th>Factura</th><th>Transportista / ETA</th><th>Estado</th><th>Actualizar</th></tr></thead><tbody>
<% var next = { requested: ['assigned','cancelled'], assigned: ['picked_up','cancelled'], picked_up: ['in_transit'], in_transit: ['delivered'], delivered: [], cancelled: [] }; %>
<% rows.forEach(function (t) { %><tr><td><a href="/transport?tracking=<%= t.tracking_code %>"><%= t.tracking_code %></a></td><td><%= t.order_number %><br><%- badge(t.order_status) %></td><td><%= t.origin %> → <%= t.destination_city %> (<%= t.destination_postal_code %>)<br><span class="hint"><%= cap(t.service) %> · <%= t.distance_km %> km</span></td><td class="num"><%= eur(t.price_cents) %></td><td><%- t.invoice_status ? badge(t.invoice_status) : '—' %></td><td><%= t.carrier_name || '—' %><br><span class="hint"><%= t.eta ? date(t.eta) : '' %></span></td><td><%- badge(t.status) %></td>
<td><% if (next[t.status].length) { %><form class="inline-form" data-api="/api/v1/transport-orders/<%= t.id %>" novalidate><label class="sr-only" for="ts<%= t.id %>">Estado</label><select id="ts<%= t.id %>" name="status" style="width:auto"><% next[t.status].forEach(function (s) { %><option value="<%= s %>"><%= label(s) %></option><% }) %></select><% if (t.status === 'requested') { %><input name="carrier_name" placeholder="Transportista" style="width:120px" aria-label="Transportista"><input name="eta" type="date" style="width:140px" aria-label="ETA"><% } %><input name="note" placeholder="Nota" style="width:120px" aria-label="Nota"><button class="btn btn-blue btn-sm" type="submit">Guardar</button></form><% } %></td></tr><% }) %>
</tbody></table></div><% } %></div>
<%- include('../../partials/panel-end') %>
