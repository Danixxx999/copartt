<%- include('../../partials/panel-start') %>
<h1>Transport orders</h1><p class="lead">Assign carriers (only after the transport invoice is paid) and move each shipment through picked up → in transit → delivered. Delivery completes the purchase.</p>
<div class="p-card"><% if (!rows.length) { %><div class="empty">No transport orders yet. Buyers request them from their purchase page.</div><% } else { %><div class="table-wrap"><table class="tbl"><thead><tr><th>Tracking</th><th>Order</th><th>Route</th><th class="num">Price</th><th>Invoice</th><th>Carrier / ETA</th><th>Status</th><th>Update</th></tr></thead><tbody>
<% var next = { requested: ['assigned','cancelled'], assigned: ['picked_up','cancelled'], picked_up: ['in_transit'], in_transit: ['delivered'], delivered: [], cancelled: [] }; %>
<% rows.forEach(function (t) { %><tr><td><a href="/transport?tracking=<%= t.tracking_code %>"><%= t.tracking_code %></a></td><td><%= t.order_number %><br><%- badge(t.order_status) %></td><td><%= t.origin %> → <%= t.destination_city %> (<%= t.destination_postal_code %>)<br><span class="hint"><%= cap(t.service) %> · <%= t.distance_km %> km</span></td><td class="num"><%= eur(t.price_cents) %></td><td><%- t.invoice_status ? badge(t.invoice_status) : '—' %></td><td><%= t.carrier_name || '—' %><br><span class="hint"><%= t.eta ? date(t.eta) : '' %></span></td><td><%- badge(t.status) %></td>
<td><% if (next[t.status].length) { %><form class="inline-form" data-api="/api/v1/transport-orders/<%= t.id %>" novalidate><label class="sr-only" for="ts<%= t.id %>">Status</label><select id="ts<%= t.id %>" name="status" style="width:auto"><% next[t.status].forEach(function (s) { %><option value="<%= s %>"><%= label(s) %></option><% }) %></select><% if (t.status === 'requested') { %><input name="carrier_name" placeholder="Carrier" style="width:120px" aria-label="Carrier"><input name="eta" type="date" style="width:140px" aria-label="ETA"><% } %><input name="note" placeholder="Note" style="width:120px" aria-label="Note"><button class="btn btn-blue btn-sm" type="submit">Save</button></form><% } %></td></tr><% }) %>
</tbody></table></div><% } %></div>
<%- include('../../partials/panel-end') %>
