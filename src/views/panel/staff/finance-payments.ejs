<%- include('../../partials/panel-start') %>
<h1>Cola de pagos</h1><p class="lead">Compara cada justificante de transferencia con el extracto bancario (ficticio) y luego apruébalo o recházalo con un motivo. Al aprobar se concilia la factura y, cuando está pagada por completo, se emite el PIN de recogida.</p>
<div class="kpis">
  <div class="kpi warn"><div class="v"><%= k.pending %></div><div class="l">Pendientes de revisión</div></div>
  <div class="kpi"><div class="v"><%= eur(k.pending_amount, { decimals: false }) %></div><div class="l">Importe pendiente</div></div>
  <div class="kpi ok"><div class="v"><%= eur(k.collected_30d, { decimals: false }) %></div><div class="l">Cobrado (30 días)</div></div>
  <a class="kpi info" href="/finance/balances"><div class="v"><%= eur(k.receivable, { decimals: false }) %></div><div class="l">Por cobrar</div></a>
  <a class="kpi <%= k.overdue ? 'warn' : '' %>" href="/finance/invoices?status=issued"><div class="v"><%= k.overdue %></div><div class="l">Facturas vencidas</div></a>
</div>
<div class="filters-bar"><% [['pending_review','Pendientes'],['approved','Aprobados'],['rejected','Rechazados'],['all','Todos']].forEach(function (s) { %><a class="chip <%= status === s[0] ? 'on' : '' %>" href="?status=<%= s[0] %>"><%= s[1] %></a><% }) %><a class="btn btn-light btn-sm" href="/api/v1/reports/payments.csv">Exportar CSV</a></div>
<div class="p-card"><% if (!rows.length) { %><div class="empty">La cola está vacía. 🎉</div><% } else { %>
<div class="table-wrap"><table class="tbl"><thead><tr><th>ID</th><th>Enviado</th><th>Comprador</th><th>Factura / pedido</th><th>Método</th><th>Referencia</th><th class="num">Importe</th><th>Justificante</th><th>Estado</th><th></th></tr></thead><tbody>
<% rows.forEach(function (p) { %><tr><td><%= p.id %></td><td class="hint nowrap"><%= dateTime(p.created_at) %></td><td><%= p.first_name %> <%= p.last_name %><br><span class="hint"><%= p.email %></span></td><td><%= p.invoice_number %><br><span class="hint"><%= p.order_number || p.kind %> · pagado <%= eur(p.paid_cents) %> / <%= eur(p.total_cents) %></span></td><td><%= p.method === 'card_demo' ? 'Tarjeta (sandbox)' : 'Transferencia' %><br><span class="hint"><%= p.scope %></span></td><td><code><%= p.reference %></code></td><td class="num"><strong><%= eur(p.amount_cents) %></strong></td><td><% if (p.proof_id) { %><a href="/files/payment-proof/<%= p.proof_id %>" target="_blank" rel="noopener">Abrir</a><% } else { %>—<% } %></td><td><%- badge(p.status) %><% if (p.review_note) { %><br><span class="hint"><%= p.review_note %></span><% } %></td>
<td class="actions"><% if (p.status === 'pending_review') { %><button class="btn btn-green btn-sm" type="button" data-api="/api/v1/payments/<%= p.id %>/review" data-body='{"approve":true}' data-prompt="Nota de conciliación (opcional):" data-prompt-field="note">Aprobar</button><button class="btn btn-red btn-sm" type="button" data-api="/api/v1/payments/<%= p.id %>/review" data-body='{"approve":false}' data-prompt="Motivo del rechazo (se envía al comprador):" data-prompt-field="note">Rechazar</button><% } %></td></tr><% }) %>
</tbody></table></div><% } %></div>
<%- include('../../partials/panel-end') %>
