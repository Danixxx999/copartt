<%- include('../../partials/panel-start') %>
<% var e = edit || {}; %>
<h1>Sedes</h1><p class="lead">Ubicaciones donde se almacenan, inspeccionan y recogen los vehículos.</p>
<div class="grid-2" style="align-items:start;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr)">
  <section class="p-card"><table class="tbl"><thead><tr><th>Código</th><th>Nombre</th><th>Ciudad</th><th class="num">Vehículos</th><th>Estado</th><th></th></tr></thead><tbody>
  <% rows.forEach(function (l) { %><tr><td><%= l.code %></td><td><a href="/locations/<%= l.code %>"><%= l.name %></a></td><td><%= l.city %></td><td class="num"><%= l.vehicles %></td><td><%- badge(l.active ? 'active' : 'closed') %></td><td><a class="btn btn-light btn-sm" href="?edit=<%= l.id %>">Editar</a></td></tr><% }) %></tbody></table></section>
  <section class="p-card"><h2><%= edit ? 'Editar ' + e.name : 'Nueva sede' %></h2>
    <form data-api="/api/v1/admin/locations<%= edit ? '/' + e.id : '' %>" data-method="<%= edit ? 'PATCH' : 'POST' %>" novalidate>
      <div class="form-grid">
        <% [['code','Código (3 letras)'],['name','Nombre'],['address','Dirección'],['city','Ciudad'],['province','Provincia'],['postal_code','Código postal'],['phone','Teléfono'],['email','Email'],['hours','Horario de oficina'],['pickup_hours','Horario de recogida'],['lat','Latitud'],['lng','Longitud']].forEach(function (f) { %><div class="form-row"><label for="l-<%= f[0] %>"><%= f[1] %></label><input id="l-<%= f[0] %>" name="<%= f[0] %>" value="<%= e[f[0]] !== undefined && e[f[0]] !== null ? e[f[0]] : '' %>"></div><% }) %>
      </div>
      <div class="form-row"><label for="l-d">Descripción</label><textarea id="l-d" name="description" rows="2"><%= e.description || '' %></textarea></div>
      <label class="check" style="margin-bottom:10px"><input type="checkbox" name="active" <%= !edit || e.active ? 'checked' : '' %>> Activa</label>
      <div class="actions"><button class="btn btn-blue" type="submit"><%= edit ? 'Guardar' : 'Crear sede' %></button><% if (edit) { %><a class="btn btn-light" href="/admin/locations">Crear nueva</a><% } %></div>
    </form></section>
</div>
<%- include('../../partials/panel-end') %>
