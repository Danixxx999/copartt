<%- include('../../partials/panel-start') %>
<% var e = edit || {}; var isEdit = !!edit; %>
<h1 style="display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap"><%= ht('Anuncios', 'Announcements') %> <% if (isEdit) { %><a class="btn btn-light btn-sm" href="/admin/announcements"><%= ht('+ Nuevo', '+ New') %></a><% } %></h1>
<p class="lead"><%= ht('Cree avisos y publicidad propia que se muestran a los miembros como banner bajo la cabecera y, si quiere, en su buzón de notificaciones. Elija a quién llegan y cuándo.', 'Create alerts and your own promotions shown to members as a banner under the header and, optionally, in their notifications. Choose who sees them and when.') %></p>
<div class="grid-2" style="align-items:start">
  <div>
    <section class="p-card"><h2><%= ht('Anuncios creados', 'Created announcements') %> (<%= rows.length %>)</h2>
      <% if (!rows.length) { %><div class="empty"><%= ht('Aún no hay anuncios.', 'No announcements yet.') %></div><% } %>
      <div class="table-wrap"><table class="tbl"><tbody>
      <% rows.forEach(function (a) { %><tr>
        <td><span class="ann-dot ann-<%= a.style %>"></span></td>
        <td><strong><%= a.title %></strong><br><span class="hint"><%= { all: ht('Todos', 'Everyone'), buyers: ht('Compradores', 'Buyers'), sellers: ht('Vendedores', 'Sellers'), staff: ht('Personal', 'Staff'), guest: 'Guest', basic: 'Basic', premium: 'Premium' }[a.audience] %> · <%= a.placement %><%= a.pushed_at ? ' · ' + ht('enviado al buzón', 'pushed to inbox') : '' %> · <%= a.dismissed %> <%= ht('cierres', 'dismissals') %></span></td>
        <td><%- a.live ? '<span class="badge badge-green">' + ht('Activo', 'Live') + '</span>' : '<span class="badge badge-gray">' + ht('Inactivo', 'Off') + '</span>' %></td>
        <td class="actions"><a class="btn btn-light btn-sm" href="?edit=<%= a.id %>"><%= t('Editar') %></a>
          <% if (!a.pushed_at) { %><button class="btn btn-blue btn-sm" type="button" data-api="/api/v1/admin/announcements/<%= a.id %>/push" data-confirm="<%= ht('¿Enviar este anuncio al buzón de notificaciones de la audiencia?', 'Send this announcement to the audience inbox?') %>"><%= ht('Enviar', 'Push') %></button><% } %>
          <button class="btn btn-red btn-sm" type="button" data-api="/api/v1/admin/announcements/<%= a.id %>" data-method="DELETE" data-confirm="<%= ht('¿Eliminar este anuncio?', 'Delete this announcement?') %>">✕</button></td>
      </tr><% }) %>
      </tbody></table></div>
    </section>
  </div>
  <section class="p-card"><h2><%= isEdit ? ht('Editar anuncio', 'Edit announcement') : ht('Nuevo anuncio', 'New announcement') %></h2>
    <form data-api="/api/v1/admin/announcements<%= isEdit ? '/' + e.id : '' %>" <%= isEdit ? 'data-method="PATCH"' : '' %> novalidate id="ann-form">
      <div class="form-row"><label for="an-t"><%= ht('Título', 'Title') %> *</label><input id="an-t" name="title" value="<%= e.title || '' %>" maxlength="140" required data-ann-live="title"></div>
      <div class="form-row"><label for="an-b"><%= ht('Texto', 'Body') %></label><textarea id="an-b" name="body" rows="2" maxlength="600" data-ann-live="body"><%= e.body || '' %></textarea></div>
      <div class="form-grid">
        <div class="form-row"><label for="an-s"><%= ht('Estilo', 'Style') %></label><select id="an-s" name="style" data-ann-live="style"><% [['promo', ht('Promoción (marrón)', 'Promo (brown)')], ['info', ht('Informativo (azul)', 'Info (blue)')], ['alert', ht('Alerta (rojo)', 'Alert (red)')], ['success', ht('Éxito (verde)', 'Success (green)')]].forEach(function (s) { %><option value="<%= s[0] %>" <%= (e.style || 'promo') === s[0] ? 'selected' : '' %>><%= s[1] %></option><% }) %></select></div>
        <div class="form-row"><label for="an-au"><%= ht('Audiencia', 'Audience') %></label><select id="an-au" name="audience"><% [['all', ht('Todos los miembros', 'Everyone')], ['buyers', ht('Compradores', 'Buyers')], ['sellers', ht('Vendedores', 'Sellers')], ['guest', 'Guest'], ['basic', 'Basic'], ['premium', 'Premium'], ['staff', ht('Personal', 'Staff')]].forEach(function (s) { %><option value="<%= s[0] %>" <%= (e.audience || 'all') === s[0] ? 'selected' : '' %>><%= s[1] %></option><% }) %></select></div>
        <div class="form-row"><label for="an-p"><%= ht('Dónde', 'Placement') %></label><select id="an-p" name="placement"><% [['both', ht('Banner y buzón', 'Banner and inbox')], ['banner', ht('Solo banner', 'Banner only')], ['feed', ht('Solo buzón', 'Inbox only')]].forEach(function (s) { %><option value="<%= s[0] %>" <%= (e.placement || 'both') === s[0] ? 'selected' : '' %>><%= s[1] %></option><% }) %></select></div>
      </div>
      <div class="form-grid">
        <div class="form-row"><label for="an-ct"><%= ht('Texto del botón', 'Button text') %></label><input id="an-ct" name="cta_text" value="<%= e.cta_text || '' %>" maxlength="40" placeholder="<%= ht('Ver más', 'Learn more') %>"></div>
        <div class="form-row"><label for="an-cu"><%= ht('Enlace del botón (interno, /…)', 'Button link (internal, /…)') %></label><input id="an-cu" name="cta_url" value="<%= e.cta_url || '' %>" placeholder="/vehicles?featured=1"></div>
      </div>
      <div class="form-row"><label for="an-img"><%= ht('Imagen (URL interna, opcional)', 'Image (internal URL, optional)') %></label><input id="an-img" name="image_url" value="<%= e.image_url || '' %>" placeholder="/img/copart/demo-suv.jpg"></div>
      <div class="form-grid">
        <div class="form-row"><label for="an-st"><%= ht('Empieza', 'Starts') %></label><input id="an-st" name="starts_at" type="datetime-local" value="<%= e.starts_at ? new Date(e.starts_at).toISOString().slice(0,16) : '' %>"></div>
        <div class="form-row"><label for="an-en"><%= ht('Termina (opcional)', 'Ends (optional)') %></label><input id="an-en" name="ends_at" type="datetime-local" value="<%= e.ends_at ? new Date(e.ends_at).toISOString().slice(0,16) : '' %>"></div>
      </div>
      <div class="actions" style="margin:4px 0 14px"><label class="check"><input type="checkbox" name="active" <%= e.active === false ? '' : 'checked' %>> <%= ht('Activo', 'Active') %></label><label class="check"><input type="checkbox" name="dismissible" <%= e.dismissible === false ? '' : 'checked' %>> <%= ht('El miembro puede cerrarlo', 'Member can dismiss') %></label><% if (!isEdit) { %><label class="check"><input type="checkbox" name="push_now"> <%= ht('Enviar al buzón al crear', 'Push to inbox on create') %></label><% } %></div>
      <h3 style="font-size:14px;margin:0 0 8px"><%= ht('Vista previa', 'Preview') %></h3>
      <div class="ann-stack" style="border-radius:8px;overflow:hidden;margin-bottom:14px"><div class="ann-banner ann-<%= e.style || 'promo' %>" data-ann-preview><div class="ann-text"><strong data-ann-pv="title"><%= e.title || ht('Título del anuncio', 'Announcement title') %></strong> <span data-ann-pv="body"><%= e.body || '' %></span></div></div></div>
      <button class="btn btn-blue" type="submit"><%= isEdit ? t('Guardar') : ht('Publicar anuncio', 'Publish announcement') %></button>
    </form>
  </section>
</div>
<%- include('../../partials/panel-end', { scripts: ['/js/announcement-admin.js'] }) %>
