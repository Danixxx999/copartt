<%- include('../../partials/panel-start') %>
<h1>Catalog</h1><p class="lead">Makes, models, vehicle types and damage types used by the finder, alerts and seller forms.</p>
<div class="grid-2" style="align-items:start">
  <section class="p-card"><h2>Makes &amp; models (<%= makes.length %>)</h2>
    <form class="inline-form" data-api="/api/v1/admin/catalog/makes" novalidate style="margin-bottom:10px"><label class="sr-only" for="mk">New make</label><input id="mk" name="name" placeholder="New make" style="max-width:200px"><button class="btn btn-blue btn-sm" type="submit">Add make</button></form>
    <form class="inline-form" data-api="/api/v1/admin/catalog/models" novalidate style="margin-bottom:12px"><label class="sr-only" for="mm">Make</label><select id="mm" name="make_id" style="max-width:180px"><% makes.forEach(function (m) { %><option value="<%= m.id %>"><%= m.name %></option><% }) %></select><label class="sr-only" for="mn">Model</label><input id="mn" name="name" placeholder="New model" style="max-width:180px"><button class="btn btn-blue btn-sm" type="submit">Add model</button></form>
    <div style="max-height:520px;overflow:auto"><table class="tbl"><tbody><% makes.forEach(function (m) { %><tr><td><strong><%= m.name %></strong><br><span class="hint"><%= m.models.map(function (x) { return x.name; }).join(', ') %></span></td><td><button class="btn btn-light btn-xs" type="button" data-api="/api/v1/admin/catalog/makes/<%= m.id %>" data-method="DELETE" data-confirm="Delete make <%= m.name %>? Only possible if no vehicle uses it.">Delete</button></td></tr><% }) %></tbody></table></div>
  </section>
  <div>
    <section class="p-card"><h2>Vehicle types</h2>
      <form class="inline-form" data-api="/api/v1/admin/catalog/vehicle-types" novalidate style="margin-bottom:10px"><input name="code" placeholder="code" style="max-width:120px" aria-label="Code"><input name="name" placeholder="Name" style="max-width:180px" aria-label="Name"><button class="btn btn-blue btn-sm" type="submit">Add</button></form>
      <table class="tbl"><tbody><% types.forEach(function (x) { %><tr><td><code><%= x.code %></code></td><td><%= x.name %></td><td><button class="btn btn-light btn-xs" type="button" data-api="/api/v1/admin/catalog/vehicle-types/<%= x.id %>" data-method="DELETE" data-confirm="Delete?">Delete</button></td></tr><% }) %></tbody></table></section>
    <section class="p-card"><h2>Damage types</h2>
      <form class="inline-form" data-api="/api/v1/admin/catalog/damage-types" novalidate style="margin-bottom:10px"><input name="code" placeholder="code" style="max-width:120px" aria-label="Code"><input name="name" placeholder="Name" style="max-width:180px" aria-label="Name"><button class="btn btn-blue btn-sm" type="submit">Add</button></form>
      <table class="tbl"><tbody><% damages.forEach(function (x) { %><tr><td><code><%= x.code %></code></td><td><%= x.name %></td><td><button class="btn btn-light btn-xs" type="button" data-api="/api/v1/admin/catalog/damage-types/<%= x.id %>" data-method="DELETE" data-confirm="Delete?">Delete</button></td></tr><% }) %></tbody></table></section>
  </div>
</div>
<%- include('../../partials/panel-end') %>
