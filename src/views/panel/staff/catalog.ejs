<%- include('../../partials/panel-start') %>
<h1>Catálogo</h1><p class="lead">Marcas, modelos, tipos de vehículo y tipos de daño que usan el buscador, las alertas y los formularios de vendedor.</p>
<div class="grid-2" style="align-items:start">
  <section class="p-card"><h2>Marcas y modelos (<%= makes.length %>)</h2>
    <form class="inline-form" data-api="/api/v1/admin/catalog/makes" novalidate style="margin-bottom:10px"><label class="sr-only" for="mk">Nueva marca</label><input id="mk" name="name" placeholder="Nueva marca" style="max-width:200px"><button class="btn btn-blue btn-sm" type="submit">Añadir marca</button></form>
    <form class="inline-form" data-api="/api/v1/admin/catalog/models" novalidate style="margin-bottom:12px"><label class="sr-only" for="mm">Marca</label><select id="mm" name="make_id" style="max-width:180px"><% makes.forEach(function (m) { %><option value="<%= m.id %>"><%= m.name %></option><% }) %></select><label class="sr-only" for="mn">Modelo</label><input id="mn" name="name" placeholder="Nuevo modelo" style="max-width:180px"><button class="btn btn-blue btn-sm" type="submit">Añadir modelo</button></form>
    <div style="max-height:520px;overflow:auto"><table class="tbl"><tbody><% makes.forEach(function (m) { %><tr><td><strong><%= m.name %></strong><br><span class="hint"><%= m.models.map(function (x) { return x.name; }).join(', ') %></span></td><td><button class="btn btn-light btn-xs" type="button" data-api="/api/v1/admin/catalog/makes/<%= m.id %>" data-method="DELETE" data-confirm="¿Eliminar la marca <%= m.name %>? Solo es posible si ningún vehículo la usa.">Eliminar</button></td></tr><% }) %></tbody></table></div>
  </section>
  <div>
    <section class="p-card"><h2>Tipos de vehículo</h2>
      <form class="inline-form" data-api="/api/v1/admin/catalog/vehicle-types" novalidate style="margin-bottom:10px"><input name="code" placeholder="código" style="max-width:120px" aria-label="Código"><input name="name" placeholder="Nombre" style="max-width:180px" aria-label="Nombre"><button class="btn btn-blue btn-sm" type="submit">Añadir</button></form>
      <table class="tbl"><tbody><% types.forEach(function (x) { %><tr><td><code><%= x.code %></code></td><td><%= x.name %></td><td><button class="btn btn-light btn-xs" type="button" data-api="/api/v1/admin/catalog/vehicle-types/<%= x.id %>" data-method="DELETE" data-confirm="¿Eliminar?">Eliminar</button></td></tr><% }) %></tbody></table></section>
    <section class="p-card"><h2>Tipos de daño</h2>
      <form class="inline-form" data-api="/api/v1/admin/catalog/damage-types" novalidate style="margin-bottom:10px"><input name="code" placeholder="código" style="max-width:120px" aria-label="Código"><input name="name" placeholder="Nombre" style="max-width:180px" aria-label="Nombre"><button class="btn btn-blue btn-sm" type="submit">Añadir</button></form>
      <table class="tbl"><tbody><% damages.forEach(function (x) { %><tr><td><code><%= x.code %></code></td><td><%= x.name %></td><td><button class="btn btn-light btn-xs" type="button" data-api="/api/v1/admin/catalog/damage-types/<%= x.id %>" data-method="DELETE" data-confirm="¿Eliminar?">Eliminar</button></td></tr><% }) %></tbody></table></section>
  </div>
</div>
<%- include('../../partials/panel-end') %>
