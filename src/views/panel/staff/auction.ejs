<%- include('../../partials/panel-start') %>
<p class="hint"><a href="/admin/auctions">← Subastas</a></p>
<h1><%= ev.name %> <%- badge(ev.status) %></h1>
<p class="lead">Empieza <%= dateTime(ev.starts_at) %> (Madrid) · <%= lots.length %> lotes · <a href="/auctions/<%= ev.id %>/live">Abrir sala en vivo</a></p>
<div class="grid-2" style="align-items:start;grid-template-columns:minmax(0,2fr) minmax(0,1fr)">
  <section class="p-card"><h2>Lotes</h2><div class="table-wrap"><table class="tbl"><thead><tr><th>#</th><th>Lote</th><th>Vehículo</th><th class="num">Salida / reserva</th><th class="num">Actual</th><th class="num">Pujas</th><th>Estado</th><th></th></tr></thead><tbody>
  <% lots.forEach(function (l, i) { %><tr><td><%= i + 1 %></td><td><a href="/lot/<%= l.lot_number %>"><%= l.lot_number %></a></td><td><%= lotTitle(l) %></td><td class="num"><%= eur(l.starting_bid_cents) %><br><span class="hint"><%= eur(l.reserve_cents) %><%= l.buy_now_cents ? ' · BIN ' + eur(l.buy_now_cents) : '' %></span></td><td class="num"><%= eur(l.current_bid_cents) %></td><td class="num"><%= l.bid_count %></td><td><%- badge(l.status) %></td>
  <td class="actions"><% if (['prebidding','scheduled'].includes(l.status)) { %><% if (!l.bid_count) { %><button class="btn btn-light btn-sm" type="button" data-open-dialog="edit-<%= l.id %>">Precios</button><% } %><button class="btn btn-red btn-sm" type="button" data-api="/api/v1/admin/lots/<%= l.id %>/cancel" data-confirm="¿Cancelar el lote #<%= l.lot_number %>? Se avisará a quienes pre-pujaron.">Cancelar</button><% } %><% if (l.status === 'pending_seller_approval') { %><button class="btn btn-green btn-sm" type="button" data-api="/api/v1/seller/lots/<%= l.id %>/decision" data-body='{"accept":true}' data-confirm="¿Aceptar en nombre del vendedor?">Aceptar</button><% } %></td></tr>
  <% if (!l.bid_count && ['prebidding','scheduled'].includes(l.status)) { %><dialog id="edit-<%= l.id %>"><div class="dlg"><h2>Precios del lote #<%= l.lot_number %></h2><form data-api="/api/v1/admin/lots/<%= l.id %>" data-method="PATCH" novalidate><div class="form-grid"><div class="form-row"><label for="sb<%= l.id %>">Precio de salida (€)</label><input id="sb<%= l.id %>" name="starting_bid" type="number" step="25" value="<%= l.starting_bid_cents / 100 %>"></div><div class="form-row"><label for="rs<%= l.id %>">Reserva (€)</label><input id="rs<%= l.id %>" name="reserve" type="number" step="25" value="<%= l.reserve_cents / 100 %>"></div><div class="form-row"><label for="bn<%= l.id %>">Buy It Now (€, vacío = ninguno)</label><input id="bn<%= l.id %>" name="buy_now" type="number" step="25" value="<%= l.buy_now_cents ? l.buy_now_cents / 100 : '' %>"></div></div><div class="dlg-actions"><button class="btn btn-light" type="button" data-close>Cancelar</button><button class="btn btn-blue" type="submit">Guardar</button></div></form></div></dialog><% } %>
  <% }) %></tbody></table></div></section>
  <section class="p-card"><h2>Evento</h2>
    <% if (ev.status === 'scheduled') { %>
      <form data-api="/api/v1/admin/events/<%= ev.id %>" data-method="PATCH" novalidate>
        <div class="form-row"><label for="n">Nombre</label><input id="n" name="name" value="<%= ev.name %>"></div>
        <div class="form-row"><label for="s">Inicio (Madrid)</label><input id="s" name="starts_at" type="datetime-local" value="<%= new Intl.DateTimeFormat('sv-SE', { timeZone: 'Europe/Madrid', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' }).format(new Date(ev.starts_at)).replace(' ', 'T') %>"></div>
        <div class="form-row"><label for="l">Ubicación</label><select id="l" name="location_id"><option value="">Nacional</option><% locations.forEach(function (x) { %><option value="<%= x.id %>" <%= ev.location_id === x.id ? 'selected' : '' %>><%= x.name %></option><% }) %></select></div>
        <button class="btn btn-blue" type="submit">Guardar</button>
      </form>
      <hr style="border:0;border-top:1px solid #e3e7ee;margin:16px 0"><button class="btn btn-green btn-block" type="button" data-api="/api/v1/admin/events/<%= ev.id %>/start" data-confirm="¿Iniciar ahora?">Iniciar la subasta ahora</button>
    <% } else { %><p class="hint">Iniciada <%= ev.started_at ? dateTime(ev.started_at) : '—' %><%= ev.ended_at ? ' · finalizada ' + dateTime(ev.ended_at) : '' %>.</p><% } %>
  </section>
</div>
<%- include('../../partials/panel-end') %>
