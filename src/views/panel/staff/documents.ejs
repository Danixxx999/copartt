<%- include('../../partials/panel-start') %>
<h1>Revisión de documentos</h1><p class="lead">Documentos de identidad y de empresa. Al aprobarlos, los miembros Basic/Premium pueden pujar.</p>
<div class="filters-bar"><% [['pending','Pendientes'],['approved','Aprobados'],['rejected','Rechazados'],['all','Todos']].forEach(function (s) { %><a class="chip <%= status === s[0] ? 'on' : '' %>" href="?status=<%= s[0] %>"><%= s[1] %></a><% }) %></div>
<div class="p-card"><% if (!rows.length) { %><div class="empty">No hay documentos en este estado.</div><% } else { %>
<div class="table-wrap"><table class="tbl"><thead><tr><th>Subido</th><th>Usuario</th><th>Tipo</th><th>Archivo</th><th>Estado</th><th></th></tr></thead><tbody>
<% rows.forEach(function (d) { %><tr><td class="hint"><%= dateTime(d.created_at) %></td><td><a href="/admin/users/<%= d.user_id %>"><%= d.first_name %> <%= d.last_name %></a><br><span class="hint"><%= d.email %> · <%= d.account_type %></span></td><td><%= d.doc_type.replace(/_/g,' ') %></td><td><a href="/files/verification/<%= d.id %>" target="_blank" rel="noopener"><%= d.original_name %></a><br><span class="hint"><%= Math.round(d.size_bytes / 1024) %> KB · <%= d.mime %></span></td><td><%- badge(d.status) %><% if (d.rejection_reason) { %><br><span class="hint"><%= d.rejection_reason %></span><% } %></td>
<td class="actions"><% if (d.status === 'pending') { %><button class="btn btn-green btn-sm" type="button" data-api="/api/v1/admin/documents/<%= d.id %>/review" data-body='{"approve":true}' data-confirm="¿Aprobar este documento?">Aprobar</button><button class="btn btn-red btn-sm" type="button" data-api="/api/v1/admin/documents/<%= d.id %>/review" data-body='{"approve":false}' data-prompt="Motivo del rechazo (se envía al usuario):">Rechazar</button><% } %></td></tr><% }) %>
</tbody></table></div><% } %></div>
<%- include('../../partials/panel-end') %>
