<%- include('../../partials/panel-start') %>
<h1 style="display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap">Contenido y banners <span class="actions"><button class="btn btn-green btn-sm" type="button" data-open-dialog="new-page"><svg class="ic"><use href="#i-plus"/></svg> Nueva página</button><button class="btn btn-light btn-sm" type="button" data-open-dialog="new-banner"><svg class="ic"><use href="#i-plus"/></svg> Nuevo banner</button></span></h1>
<p class="lead">Publica tus propias páginas (aparecen en <code>/page/&lt;dirección&gt;</code>) y banners: los banners <strong>top</strong> salen bajo el menú principal en todas las páginas, los banners <strong>home</strong> salen en la página de inicio. Al guardar se eliminan los scripts y los manejadores en línea.</p>
<div class="grid-2" style="align-items:start">
  <div>
    <section class="p-card"><h2>Páginas (<%= pages.length %>)</h2><table class="tbl"><tbody><% pages.forEach(function (p) { %><tr><td><strong><%= p.title %></strong><br><span class="hint">/page/<%= p.slug %> · actualizada <%= date(p.updated_at) %></span></td><td><%- p.published ? '<span class="badge badge-green">Publicada</span>' : '<span class="badge badge-gray">Borrador</span>' %></td><td class="actions"><a class="btn btn-light btn-sm" href="?page=<%= p.slug %>">Editar</a><a class="btn btn-light btn-sm" href="/page/<%= p.slug %>" target="_blank" rel="noopener">Ver</a></td></tr><% }) %></tbody></table></section>
    <% banners.forEach(function (b) { %><section class="p-card"><h2 style="display:flex;justify-content:space-between;gap:8px">Banner #<%= b.id %> · <%= b.placement %> <%- b.active ? '<span class="badge badge-green">Activo</span>' : '<span class="badge badge-gray">Oculto</span>' %></h2>
      <form data-api="/api/v1/admin/banners/<%= b.id %>" data-method="PATCH" novalidate>
        <div class="form-row"><label for="bt<%= b.id %>">Texto</label><input id="bt<%= b.id %>" name="text" value="<%= b.text %>"></div>
        <div class="form-grid"><div class="form-row"><label for="bl<%= b.id %>">Texto del enlace</label><input id="bl<%= b.id %>" name="link_text" value="<%= b.link_text || '' %>"></div><div class="form-row"><label for="bu<%= b.id %>">URL del enlace</label><input id="bu<%= b.id %>" name="link_url" value="<%= b.link_url || '' %>"></div></div>
        <label class="check" style="margin-bottom:10px"><input type="checkbox" name="active" <%= b.active ? 'checked' : '' %>> Activo</label>
        <div class="actions"><button class="btn btn-blue" type="submit">Guardar banner</button><button class="btn btn-red btn-sm" type="button" data-api="/api/v1/admin/banners/<%= b.id %>" data-method="DELETE" data-confirm="¿Eliminar este banner?">Eliminar</button></div></form></section><% }) %>
  </div>
  <section class="p-card"><% if (edit) { %><h2>Editar: <%= edit.title %></h2>
    <form data-api="/api/v1/admin/pages/<%= edit.slug %>" data-method="PATCH" novalidate>
      <div class="form-row"><label for="pt">Título</label><input id="pt" name="title" value="<%= edit.title %>"></div>
      <div class="form-row"><label for="pb">Cuerpo (HTML)</label><textarea id="pb" name="body_html" rows="18" style="font-family:monospace;font-size:13px"><%= edit.body_html %></textarea><span class="hint">Permitido: títulos, párrafos, listas, enlaces, imágenes de /uploads, tablas.</span></div>
      <label class="check" style="margin-bottom:10px"><input type="checkbox" name="published" <%= edit.published ? 'checked' : '' %>> Publicada</label>
      <div class="actions"><button class="btn btn-blue" type="submit">Guardar página</button><a class="btn btn-light" href="/page/<%= edit.slug %>" target="_blank" rel="noopener">Vista previa</a><% if (!['terms','privacy','cookie-policy','company-details','about-us'].includes(edit.slug)) { %><button class="btn btn-red" type="button" data-api="/api/v1/admin/pages/<%= edit.slug %>" data-method="DELETE" data-confirm="¿Eliminar la página /page/<%= edit.slug %>?">Eliminar página</button><% } %></div></form>
  <% } else { %><div class="empty">Selecciona una página para editar o crea una nueva.</div><% } %></section>
</div>
<dialog id="new-page"><div class="dlg dlg-wide"><h2>Nueva página</h2><form data-api="/api/v1/admin/pages" novalidate>
  <div class="form-grid"><div class="form-row"><label for="np-s">Dirección *</label><input id="np-s" name="slug" placeholder="promo-noviembre" required><span class="hint">Publicada en /page/dirección</span></div><div class="form-row"><label for="np-t">Título *</label><input id="np-t" name="title" required></div></div>
  <div class="form-row"><label for="np-b">Cuerpo (HTML)</label><textarea id="np-b" name="body_html" rows="8" style="font-family:monospace;font-size:13px"><h2>Título</h2>
<p>Escribe tu contenido aquí.</p></textarea></div>
  <label class="check" style="margin-bottom:10px"><input type="checkbox" name="published" checked> Publicar ahora</label>
  <div class="dlg-actions"><button class="btn btn-light" type="button" data-close>Cancelar</button><button class="btn btn-green" type="submit">Crear página</button></div></form></div></dialog>
<dialog id="new-banner"><div class="dlg"><h2>Nuevo banner</h2><form data-api="/api/v1/admin/banners" novalidate>
  <div class="form-row"><label for="nb-p">Ubicación</label><select id="nb-p" name="placement"><option value="home">Página de inicio</option><option value="top">Parte superior de cada página</option></select></div>
  <div class="form-row"><label for="nb-t">Texto *</label><input id="nb-t" name="text" required></div>
  <div class="form-grid"><div class="form-row"><label for="nb-lt">Texto del enlace</label><input id="nb-lt" name="link_text"></div><div class="form-row"><label for="nb-lu">URL del enlace</label><input id="nb-lu" name="link_url" placeholder="/vehicles"></div></div>
  <label class="check" style="margin-bottom:10px"><input type="checkbox" name="active" checked> Activo</label>
  <div class="dlg-actions"><button class="btn btn-light" type="button" data-close>Cancelar</button><button class="btn btn-green" type="submit">Crear banner</button></div></form></div></dialog>
<%- include('../../partials/panel-end') %>
