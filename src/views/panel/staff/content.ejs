<%- include('../../partials/panel-start') %>
<h1 style="display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap">Content &amp; banners <span class="actions"><button class="btn btn-green btn-sm" type="button" data-open-dialog="new-page"><svg class="ic"><use href="#i-plus"/></svg> New page</button><button class="btn btn-light btn-sm" type="button" data-open-dialog="new-banner"><svg class="ic"><use href="#i-plus"/></svg> New banner</button></span></h1>
<p class="lead">Publish your own pages (they appear at <code>/page/&lt;address&gt;</code>) and banners: <strong>top</strong> banners show under the main menu on every page, <strong>home</strong> banners show on the home page. Scripts and inline handlers are stripped on save.</p>
<div class="grid-2" style="align-items:start">
  <div>
    <section class="p-card"><h2>Pages (<%= pages.length %>)</h2><table class="tbl"><tbody><% pages.forEach(function (p) { %><tr><td><strong><%= p.title %></strong><br><span class="hint">/page/<%= p.slug %> · updated <%= date(p.updated_at) %></span></td><td><%- p.published ? '<span class="badge badge-green">Published</span>' : '<span class="badge badge-gray">Draft</span>' %></td><td class="actions"><a class="btn btn-light btn-sm" href="?page=<%= p.slug %>">Edit</a><a class="btn btn-light btn-sm" href="/page/<%= p.slug %>" target="_blank" rel="noopener">View</a></td></tr><% }) %></tbody></table></section>
    <% banners.forEach(function (b) { %><section class="p-card"><h2 style="display:flex;justify-content:space-between;gap:8px">Banner #<%= b.id %> · <%= b.placement %> <%- b.active ? '<span class="badge badge-green">Active</span>' : '<span class="badge badge-gray">Hidden</span>' %></h2>
      <form data-api="/api/v1/admin/banners/<%= b.id %>" data-method="PATCH" novalidate>
        <div class="form-row"><label for="bt<%= b.id %>">Text</label><input id="bt<%= b.id %>" name="text" value="<%= b.text %>"></div>
        <div class="form-grid"><div class="form-row"><label for="bl<%= b.id %>">Link text</label><input id="bl<%= b.id %>" name="link_text" value="<%= b.link_text || '' %>"></div><div class="form-row"><label for="bu<%= b.id %>">Link URL</label><input id="bu<%= b.id %>" name="link_url" value="<%= b.link_url || '' %>"></div></div>
        <label class="check" style="margin-bottom:10px"><input type="checkbox" name="active" <%= b.active ? 'checked' : '' %>> Active</label>
        <div class="actions"><button class="btn btn-blue" type="submit">Save banner</button><button class="btn btn-red btn-sm" type="button" data-api="/api/v1/admin/banners/<%= b.id %>" data-method="DELETE" data-confirm="Delete this banner?">Delete</button></div></form></section><% }) %>
  </div>
  <section class="p-card"><% if (edit) { %><h2>Edit: <%= edit.title %></h2>
    <form data-api="/api/v1/admin/pages/<%= edit.slug %>" data-method="PATCH" novalidate>
      <div class="form-row"><label for="pt">Title</label><input id="pt" name="title" value="<%= edit.title %>"></div>
      <div class="form-row"><label for="pb">Body (HTML)</label><textarea id="pb" name="body_html" rows="18" style="font-family:monospace;font-size:13px"><%= edit.body_html %></textarea><span class="hint">Allowed: headings, paragraphs, lists, links, images from /uploads, tables.</span></div>
      <label class="check" style="margin-bottom:10px"><input type="checkbox" name="published" <%= edit.published ? 'checked' : '' %>> Published</label>
      <div class="actions"><button class="btn btn-blue" type="submit">Save page</button><a class="btn btn-light" href="/page/<%= edit.slug %>" target="_blank" rel="noopener">Preview</a><% if (!['terms','privacy','cookie-policy','company-details','about-us'].includes(edit.slug)) { %><button class="btn btn-red" type="button" data-api="/api/v1/admin/pages/<%= edit.slug %>" data-method="DELETE" data-confirm="Delete page /page/<%= edit.slug %>?">Delete page</button><% } %></div></form>
  <% } else { %><div class="empty">Select a page to edit, or create a new one.</div><% } %></section>
</div>
<dialog id="new-page"><div class="dlg dlg-wide"><h2>New page</h2><form data-api="/api/v1/admin/pages" novalidate>
  <div class="form-grid"><div class="form-row"><label for="np-s">Address *</label><input id="np-s" name="slug" placeholder="promo-november" required><span class="hint">Published at /page/address</span></div><div class="form-row"><label for="np-t">Title *</label><input id="np-t" name="title" required></div></div>
  <div class="form-row"><label for="np-b">Body (HTML)</label><textarea id="np-b" name="body_html" rows="8" style="font-family:monospace;font-size:13px"><h2>Title</h2>
<p>Write your content here.</p></textarea></div>
  <label class="check" style="margin-bottom:10px"><input type="checkbox" name="published" checked> Publish now</label>
  <div class="dlg-actions"><button class="btn btn-light" type="button" data-close>Cancel</button><button class="btn btn-green" type="submit">Create page</button></div></form></div></dialog>
<dialog id="new-banner"><div class="dlg"><h2>New banner</h2><form data-api="/api/v1/admin/banners" novalidate>
  <div class="form-row"><label for="nb-p">Placement</label><select id="nb-p" name="placement"><option value="home">Home page</option><option value="top">Top of every page</option></select></div>
  <div class="form-row"><label for="nb-t">Text *</label><input id="nb-t" name="text" required></div>
  <div class="form-grid"><div class="form-row"><label for="nb-lt">Link text</label><input id="nb-lt" name="link_text"></div><div class="form-row"><label for="nb-lu">Link URL</label><input id="nb-lu" name="link_url" placeholder="/vehicles"></div></div>
  <label class="check" style="margin-bottom:10px"><input type="checkbox" name="active" checked> Active</label>
  <div class="dlg-actions"><button class="btn btn-light" type="button" data-close>Cancel</button><button class="btn btn-green" type="submit">Create banner</button></div></form></div></dialog>
<%- include('../../partials/panel-end') %>
