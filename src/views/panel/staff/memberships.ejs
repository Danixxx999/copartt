<%- include('../../partials/panel-start') %>
<h1>Membresías y límites de puja</h1><p class="lead">Reglas de negocio que el servidor aplica en cada puja. Deja un límite vacío para “sin límite”.</p>
<div class="grid-3"><% plans.forEach(function (p) { %>
  <section class="p-card"><h2><%= p.name %> <span class="hint">(<%= p.members %> activos)</span></h2>
    <form data-api="/api/v1/admin/plans/<%= p.id %>" data-method="PATCH" data-confirm="¿Actualizar las reglas de <%= p.name %>? Se aplica de inmediato a las pujas nuevas." novalidate>
      <div class="form-row"><label for="n<%= p.id %>">Nombre</label><input id="n<%= p.id %>" name="name" value="<%= p.name %>"></div>
      <div class="form-row"><label for="pr<%= p.id %>">Precio por año (€, sin IVA)</label><input id="pr<%= p.id %>" name="price" type="number" step="0.01" min="0" value="<%= p.price_cents / 100 %>"></div>
      <div class="form-row"><label for="mb<%= p.id %>">Puja máxima por vehículo (€)</label><input id="mb<%= p.id %>" name="max_bid" type="number" min="0" value="<%= p.max_bid_cents ? p.max_bid_cents / 100 : '' %>"></div>
      <div class="form-row"><label for="mt<%= p.id %>">Límite combinado por subasta (€)</label><input id="mt<%= p.id %>" name="max_total" type="number" min="0" value="<%= p.max_total_cents ? p.max_total_cents / 100 : '' %>"></div>
      <div class="form-row"><label for="ml<%= p.id %>">Máx. vehículos por subasta</label><input id="ml<%= p.id %>" name="max_lots_per_event" type="number" min="0" value="<%= p.max_lots_per_event || '' %>"></div>
      <div class="form-row"><label for="d<%= p.id %>">Descripción</label><textarea id="d<%= p.id %>" name="description" rows="2"><%= p.description %></textarea></div>
      <div class="actions" style="margin-bottom:10px"><label class="check"><input type="checkbox" name="can_bid" <%= p.can_bid ? 'checked' : '' %>> Puede pujar</label><label class="check"><input type="checkbox" name="requires_documents" <%= p.requires_documents ? 'checked' : '' %>> Requiere documentos</label><label class="check"><input type="checkbox" name="active" <%= p.active ? 'checked' : '' %>> Activo</label></div>
      <button class="btn btn-blue" type="submit">Guardar</button>
    </form>
  </section>
<% }) %></div>
<section class="p-card"><h2>Tabla de incrementos de puja</h2><p class="hint">Edítala en <a href="/admin/settings">Ajustes › bid_increments</a>.</p><table class="tbl"><thead><tr><th>Precio hasta</th><th>Incremento</th></tr></thead><tbody><% increments.forEach(function (r) { %><tr><td><%= r.up_to_cents ? eur(r.up_to_cents) : 'Superior' %></td><td><%= eur(r.increment_cents) %></td></tr><% }) %></tbody></table></section>
<%- include('../../partials/panel-end') %>
