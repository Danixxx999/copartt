<%- include('../../partials/panel-start') %>
<h1>Ajustes</h1><p class="lead">Comisiones, impuestos, incrementos, tiempos de subasta, tarifas de transporte y datos bancarios (todos valores de demostración). Los valores son JSON. Los cambios quedan auditados y se aplican de inmediato.</p>
<div class="alert alert-warn">Las comisiones e impuestos son ejemplos académicos, no tarifas reales.</div>
<% rows.forEach(function (s) { %><section class="p-card"><h2><code><%= s.key %></code></h2><p class="hint"><%= s.description %> · actualizado <%= dateTime(s.updated_at) %></p>
  <form data-api="/api/v1/admin/settings/<%= s.key %>" data-method="PATCH" data-confirm="¿Guardar el ajuste <%= s.key %>?" novalidate><label class="sr-only" for="v-<%= s.key %>">Valor</label><textarea id="v-<%= s.key %>" name="value" rows="<%= Math.min(8, JSON.stringify(s.value, null, 2).split('\n').length) %>" style="font-family:monospace;font-size:13px"><%= JSON.stringify(s.value, null, 2) %></textarea><button class="btn btn-blue btn-sm" type="submit" style="margin-top:8px">Guardar</button></form>
</section><% }) %>
<section class="p-card"><h2>Resúmenes de alertas de vehículos</h2><p class="hint">En producción esto correría de forma programada. Aquí puedes dispararlo manualmente; los correos van al buzón Demo.</p><div class="actions"><button class="btn btn-light" type="button" data-api="/api/v1/admin/alerts/digest" data-body='{"frequency":"daily"}'>Enviar resumen diario</button><button class="btn btn-light" type="button" data-api="/api/v1/admin/alerts/digest" data-body='{"frequency":"weekly"}'>Enviar resumen semanal</button></div></section>
<%- include('../../partials/panel-end') %>
