<%- include('../../partials/panel-start') %>
<h1>Vendedores</h1><p class="lead">Apruebe las solicitudes de vendedor antes de que puedan publicar vehículos.</p>
<div class="p-card"><div class="table-wrap"><table class="tbl"><thead><tr><th>Empresa</th><th>Tipo</th><th>Cuenta</th><th class="num">Vehículos</th><th class="num">Ventas</th><th>Estado</th><th></th></tr></thead><tbody>
<% rows.forEach(function (s) { %><tr><td><strong><%= s.company_name %></strong></td><td><%= s.seller_type %></td><td><a href="/admin/users/<%= s.user_id %>"><%= s.email %></a></td><td class="num"><%= s.vehicles %></td><td class="num"><%= eur(s.sales) %></td><td><%- badge(s.approved ? 'approved' : 'pending') %></td><td><% if (s.approved) { %><button class="btn btn-light btn-sm" type="button" data-api="/api/v1/admin/sellers/<%= s.id %>/approve" data-body='{"approve":false}' data-confirm="¿Desactivar este vendedor?">Desactivar</button><% } else { %><button class="btn btn-green btn-sm" type="button" data-api="/api/v1/admin/sellers/<%= s.id %>/approve" data-body='{"approve":true}'>Aprobar</button><% } %></td></tr><% }) %>
</tbody></table></div></div>
<%- include('../../partials/panel-end') %>
