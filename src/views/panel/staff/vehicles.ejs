<%- include('../../partials/panel-start') %>
<h1 style="display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap">Vehicles &amp; approvals <a class="btn btn-green btn-sm" href="/admin/vehicles/new"><svg class="ic"><use href="#i-plus"/></svg> Add vehicle</a></h1><p class="lead">Approve seller vehicles by assigning them to an auction with a starting bid and reserve. Matching vehicle alerts are triggered automatically.</p>
<div class="filters-bar"><% [['pending_approval','Pending'],['approved','Approved'],['rejected','Rejected'],['draft','Drafts'],['sold','Sold'],['withdrawn','Withdrawn'],['all','All']].forEach(function (s) { %><a class="chip <%= status === s[0] ? 'on' : '' %>" href="?status=<%= s[0] %>"><%= s[1] %></a><% }) %><a class="btn btn-light btn-sm" href="/api/v1/reports/inventory.csv">Export CSV</a></div>
<div class="p-card"><% if (!rows.length) { %><div class="empty">No vehicles in this state.</div><% } else { %>
<div class="table-wrap"><table class="tbl"><thead><tr><th></th><th>Vehicle</th><th>Seller</th><th>Yard</th><th class="num">Photos/docs</th><th>Status</th><th>Lot</th><th></th></tr></thead><tbody>
<% rows.forEach(function (v) { %><tr><td><% if (v.image) { %><img class="mini-img" src="<%= v.image %>" alt=""><% } %></td><td><strong><%= v.year %> <%= v.make %> <%= v.model %></strong><br><span class="hint">#<%= v.id %> · <code><%= v.vin %></code> · <%= cap(v.condition) %></span></td><td><%= v.company_name %></td><td><%= v.yard %></td><td class="num"><%= v.photos %> / <%= v.docs %></td><td><%- badge(v.status) %></td><td><% if (v.lot_number) { %><a href="/lot/<%= v.lot_number %>">#<%= v.lot_number %></a><% } else { %>—<% } %></td><td class="actions"><a class="btn btn-blue btn-sm" href="/admin/vehicles/<%= v.id %>"><%= v.status === 'pending_approval' ? 'Review' : 'Open' %></a><% if (v.status !== 'sold') { %><a class="btn btn-light btn-sm" href="/admin/vehicles/<%= v.id %>/edit">Edit</a><% } %></td></tr><% }) %>
</tbody></table></div><% } %></div>
<%- include('../../partials/panel-end') %>
