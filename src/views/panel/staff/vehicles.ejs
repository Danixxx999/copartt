<%- include('../../partials/panel-start') %>
<h1 style="display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap">Vehículos y aprobaciones <a class="btn btn-green btn-sm" href="/admin/vehicles/new"><svg class="ic"><use href="#i-plus"/></svg> Añadir vehículo</a></h1><p class="lead">Apruebe los vehículos de los vendedores asignándolos a una subasta con precio de salida y reserva. Las alertas de vehículos que coincidan se disparan automáticamente.</p>
<div class="filters-bar"><% [['pending_approval','Pendientes'],['approved','Aprobados'],['rejected','Rechazados'],['draft','Borradores'],['sold','Vendidos'],['withdrawn','Retirados'],['all','Todos']].forEach(function (s) { %><a class="chip <%= status === s[0] ? 'on' : '' %>" href="?status=<%= s[0] %>"><%= s[1] %></a><% }) %><a class="btn btn-light btn-sm" href="/api/v1/reports/inventory.csv">Exportar CSV</a></div>
<div class="p-card"><% if (!rows.length) { %><div class="empty">No hay vehículos en este estado.</div><% } else { %>
<div class="table-wrap"><table class="tbl"><thead><tr><th></th><th>Vehículo</th><th>Vendedor</th><th>Sede</th><th class="num">Fotos/docs</th><th>Estado</th><th>Lote</th><th></th></tr></thead><tbody>
<% rows.forEach(function (v) { %><tr><td><% if (v.image) { %><img class="mini-img" src="<%= v.image %>" alt=""><% } %></td><td><strong><%= v.year %> <%= v.make %> <%= v.model %></strong><br><span class="hint">#<%= v.id %> · <code><%= v.vin %></code> · <%= cap(v.condition) %></span></td><td><%= v.company_name %></td><td><%= v.yard %></td><td class="num"><%= v.photos %> / <%= v.docs %></td><td><%- badge(v.status) %></td><td><% if (v.lot_number) { %><a href="/lot/<%= v.lot_number %>">#<%= v.lot_number %></a><% } else { %>—<% } %></td><td class="actions"><a class="btn btn-blue btn-sm" href="/admin/vehicles/<%= v.id %>"><%= v.status === 'pending_approval' ? 'Revisar' : 'Abrir' %></a><% if (v.status !== 'sold') { %><a class="btn btn-light btn-sm" href="/admin/vehicles/<%= v.id %>/edit">Editar</a><% } %></td></tr><% }) %>
</tbody></table></div><% } %></div>
<%- include('../../partials/panel-end') %>
