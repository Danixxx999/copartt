<%- include('../../partials/panel-start') %>
<h1>Outstanding balances</h1><p class="lead">Amounts owed per customer and orders awaiting payment.</p>
<div class="grid-2" style="align-items:start">
  <section class="p-card"><h2>By customer</h2><% if (!rows.length) { %><div class="empty">Nothing owed.</div><% } else { %><table class="tbl"><thead><tr><th>Customer</th><th class="num">Invoices</th><th class="num">Outstanding</th><th>Oldest due</th></tr></thead><tbody><% rows.forEach(function (r) { %><tr><td><a href="/admin/users/<%= r.id %>"><%= r.first_name %> <%= r.last_name %></a><br><span class="hint"><%= r.company_name || r.email %></span></td><td class="num"><%= r.invoices %></td><td class="num"><strong><%= eur(r.outstanding) %></strong></td><td style="<%= new Date(r.oldest_due) < new Date() ? 'color:#b91c1c' : '' %>"><%= date(r.oldest_due) %></td></tr><% }) %></tbody></table><% } %></section>
  <section class="p-card"><h2>Orders awaiting payment</h2><% if (!orders.length) { %><div class="empty">None.</div><% } else { %><table class="tbl"><tbody><% orders.forEach(function (o) { %><tr><td><%= o.order_number %><br><span class="hint"><%= o.email %></span></td><td class="num"><%= eur(o.hammer_cents) %></td><td><%- badge(o.status) %></td><td class="hint"><%= date(o.created_at) %></td></tr><% }) %></tbody></table><% } %></section>
</div>
<section class="p-card"><h2><%= t('Depósitos') %> (<%= deposits.filter(function (d) { return d.status === 'refund_requested'; }).length %> <%= ht('reembolsos pendientes', 'refunds pending') %>)</h2>
  <% if (!deposits.length) { %><div class="empty"><%= ht('Sin depósitos.', 'No deposits.') %></div><% } else { %><div class="table-wrap"><table class="tbl"><thead><tr><th><%= ht('Fecha', 'Date') %></th><th><%= ht('Miembro', 'Member') %></th><th><%= ht('Referencia', 'Reference') %></th><th><%= ht('Proveedor', 'Provider') %></th><th class="num"><%= ht('Importe', 'Amount') %></th><th><%= ht('Estado', 'Status') %></th><th></th></tr></thead><tbody>
  <% deposits.forEach(function (d) { %><tr><td class="hint"><%= dateTime(d.created_at) %></td><td><a href="/admin/users/<%= d.user_id %>"><%= d.email %></a></td><td><code><%= d.reference %></code><br><span class="hint"><%= d.brand ? d.brand.toUpperCase() + ' ***' + d.last4 : '' %></span></td><td><%= d.provider %></td><td class="num"><%= eur(d.amount_cents) %></td><td><%- badge(d.status === 'held' ? 'active' : d.status === 'refund_requested' ? 'pending' : 'closed') %></td>
    <td><% if (d.status !== 'refunded') { %><button class="btn btn-<%= d.status === 'refund_requested' ? 'green' : 'light' %> btn-sm" type="button" data-api="/api/v1/finance/deposits/<%= d.id %>/refund" data-confirm="<%= ht('¿Reembolsar este depósito?', 'Refund this deposit?') %>"><%= ht('Reembolsar', 'Refund') %></button><% } %></td></tr><% }) %>
  </tbody></table></div><% } %>
</section>
<%- include('../../partials/panel-end') %>
