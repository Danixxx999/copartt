<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main id="main" class="reference-home">
  <% if(homeBanners && homeBanners.length) { %><div class="home-banners"><% homeBanners.forEach(function(b){ %><div class="home-banner"><span><%= b.text %></span><% if(b.link_url) { %> <a href="<%= b.link_url %>"><%= b.link_text || 'Ver más' %> ›</a><% } %></div><% }) %></div><% } %>
  <section class="home-hero" data-hero-carousel aria-label="Novedades de copart" aria-roledescription="carrusel">
    <article class="home-slide home-slide-intro" data-hero-slide <%= isMemberPortal ? 'hidden' : '' %>>
      <div class="home-hero-copy"><h1><%= ht('Subastas de Autos 100% En línea','100% Online Auto Auctions') %></h1><p class="home-hero-lead"><%= ht('Autos, camionetas y SUVs usados y reparables.','Used and repairable cars, trucks and SUVs.') %> <strong><%= stats.open %> <%= ht('vehículos','vehicles') %></strong> <%= ht('disponibles para explorar.','available to explore.') %></p>
        <div class="home-steps"><div><h2><b>1</b> <%= isMemberPortal?ht('Busque','Search'):ht('Regístrese','Register') %></h2><p><%= isMemberPortal?ht('Busque en nuestro inventario de vehículos disponibles y encuentre su próxima oportunidad.','Search available vehicles and find your next opportunity.'):ht('Regístrese y elija una membresía Basic o Premium para comenzar.','Sign up and choose a Basic or Premium Membership to get started.') %></p></div><div><h2><b>2</b> <%= ht('Encuentre','Find') %></h2><p><%= ht('Establezca listas de seguimiento, acceda a búsquedas guardadas y configure alertas de vehículos.','Build watchlists, save searches and set up vehicle alerts.') %></p></div><div><h2><b>3</b> <%= ht('Oferte','Bid') %></h2><p><%= ht('Oferte en línea y participe en las subastas programadas desde su computadora o teléfono.','Bid in online auctions from your computer or phone.') %></p></div></div>
        <a class="btn btn-brown btn-pill" href="<%= isMemberPortal?'/vehicles':'/register' %>"><%= isMemberPortal?ht('Ver todo el inventario','View all inventory'):ht('Regístrese para comenzar a ofertar','Register to start bidding') %> ›</a>
      </div><div class="home-intro-art" aria-hidden="true"><img src="/img/copart/hero-suv-lineup.jpg" alt=""></div>
    </article>
    <article class="home-slide home-slide-wholesale" data-hero-slide <%= isMemberPortal ? '' : 'hidden' %>>
      <img class="home-wholesale-art" src="/img/copart/hero-suv-lineup.jpg" alt="<%= t('Imagen ilustrativa') %>">
      <div class="home-wholesale-copy"><h2><svg class="ic"><use href="#i-shield"/></svg><span><%= ht('Flotas', 'Fleet') %><small><%= ht('S E L E C C I Ó N', 'S E L E C T I O N') %></small></span></h2><p><%= ht('Conozca los vehículos usados seleccionados de copart', 'Discover copart selected used vehicles') %></p><a class="btn btn-blue" href="/vehicles?condition=used"><%= t('Ver Inventario') %></a></div>
    </article>
    <button class="home-hero-arrow prev" type="button" data-hero-prev aria-label="Banner anterior">‹</button><button class="home-hero-arrow next" type="button" data-hero-next aria-label="Banner siguiente">›</button>
    <a class="home-live-ribbon" href="/auctions"><% if (stats.live) { %><%= lang === 'es' ? '¡' : '' %><%= stats.live %> <%= t('Subastas de autos en vivo están sucediendo ahora') %><%= lang === 'es' ? '!' : '' %><% } else { %><%= t('Próxima subasta') %>: <%= nextEvents[0] ? nextEvents[0].name + ' · ' + dateTime(nextEvents[0].starts_at) : '—' %><% } %> ›</a><span class="home-corner" aria-hidden="true"></span>
  </section>

  <section class="home-popular" aria-labelledby="pop-title"><h2 id="pop-title"><%= t('Vehículos populares') %></h2><div class="carousel" data-carousel><button class="car-arrow prev" type="button" data-carousel-prev aria-label="Vehículos anteriores">‹</button><div class="carousel-track" data-carousel-track><% popular.forEach(function(l){ %><%- include('../partials/lot-card',{l:l}) %><% }) %></div><button class="car-arrow next" type="button" data-carousel-next aria-label="Vehículos siguientes">›</button></div></section>

  <% if (!isMemberPortal && region === 'ES') { %><section class="home-memberships" id="membership-options"><h2><%= ht('Opciones de membresía','Membership Options') %></h2><p class="membership-intro"><%= ht('Explore el inventario, guarde sus favoritos y elija el plan que se ajusta a su forma de comprar.','Browse inventory, save your favorites and choose the membership that fits the way you buy.') %></p><%- include('../partials/plan-cards',{plans:plans,from:'home'}) %></section><% } %>

  <section class="home-browse" aria-labelledby="browse-title"><h2 id="browse-title">Subasta de Autos copart - Autos Usados y de Salvamento a la Venta</h2>
    <div class="home-browse-layout"><div><div class="tabs" data-tabs><div class="tab-list" role="tablist"><button role="tab" aria-selected="true" data-tab="home-makes">Marcas</button><button role="tab" aria-selected="false" data-tab="home-models">Modelos</button><button role="tab" aria-selected="false" data-tab="home-featured">Destacados</button><button role="tab" aria-selected="false" data-tab="home-types">Tipos</button><button role="tab" aria-selected="false" data-tab="home-regions">Regiones</button><button role="tab" aria-selected="false" data-tab="home-cities">Ciudades populares</button><button role="tab" aria-selected="false" data-tab="home-trending">Tendencias</button></div>
      <div class="tab-panel" id="home-makes" role="tabpanel"><ul class="link-cols"><% facets.makes.forEach(function(m){ %><li><a href="/vehicles?make=<%= m.slug %>"><%= m.name %></a> <span>(<%= m.count %>)</span></li><% }) %></ul></div>
      <div class="tab-panel" id="home-models" role="tabpanel" hidden><ul class="link-cols"><% homeModels.forEach(function(m){ %><li><a href="/vehicles?model=<%= m.id %>"><%= m.make %> <%= m.name %> ›</a></li><% }) %></ul></div>
      <div class="tab-panel" id="home-featured" role="tabpanel" hidden><ul class="link-cols"><li><a href="/vehicles?featured=1">Vehículos destacados</a></li><li><a href="/vehicles?odo_max=50000">Bajo kilometraje</a></li><li><a href="/vehicles?fuel=electric">Vehículos eléctricos</a></li><li><a href="/vehicles?transmission=automatic">Transmisión automática</a></li></ul></div>
      <div class="tab-panel" id="home-types" role="tabpanel" hidden><ul class="link-cols"><% facets.types.forEach(function(v){ %><li><a href="/vehicles?type=<%= v.code %>"><%= v.name %></a> <span>(<%= v.count %>)</span></li><% }) %></ul></div>
      <div class="tab-panel" id="home-regions" role="tabpanel" hidden><ul class="link-cols"><% facets.locations.forEach(function(l){ %><li><a href="/vehicles?location=<%= l.code %>"><%= l.name %></a></li><% }) %></ul></div>
      <div class="tab-panel" id="home-cities" role="tabpanel" hidden><ul class="link-cols"><% facets.locations.forEach(function(l){ %><li><a href="/vehicles?location=<%= l.code %>"><%= l.name %></a> <span>(<%= l.count %>)</span></li><% }) %></ul></div>
      <div class="tab-panel" id="home-trending" role="tabpanel" hidden><ul class="link-cols"><% facets.damages.forEach(function(d){ %><li><a href="/vehicles?damage=<%= d.code %>"><%= d.name %></a> <span>(<%= d.count %>)</span></li><% }) %></ul></div>
    </div><div class="center"><a class="btn btn-blue btn-pill" href="/vehicle-finder">VER MÁS</a></div></div><a class="home-browse-promo" href="<%= isMemberPortal?'/vehicles':'/register' %>"><strong><%= isMemberPortal?'ENCUENTRE SU PRÓXIMO VEHÍCULO':'CONVIÉRTASE EN MIEMBRO DE copart' %></strong><img src="/img/copart/hero-suv-lineup.jpg" alt="Vehículos ilustrativos"><span><%= isMemberPortal?'VER INVENTARIO':'REGÍSTRESE AHORA' %></span><small><%= isMemberPortal?'Explore el inventario y guarde sus favoritos.':'Regístrese para explorar, guardar favoritos y elegir su membresía.' %></small></a></div>
  </section>

  <section class="home-about"><div class="home-about-copy"><h2>¿Qué es copart?</h2><p>copart es una plataforma académica de subastas de autos 100% en línea. Explore vehículos usados y reparables, guarde sus favoritos y participe en las subastas del inventario de demostración.</p><p>Encuentre <a href="/vehicles?type=automobile">automóviles</a>, <a href="/vehicles?type=suv">camionetas y SUVs</a>, <a href="/vehicles?type=motorcycle">motocicletas</a> y vehículos comerciales. Consulte las especificaciones, las imágenes disponibles y la información de venta antes de ofertar.</p><p>Elija una membresía, complete la verificación de su cuenta y establezca su oferta máxima. Las pujas, los pagos y la recogida están conectados al sistema de demostración.</p><a class="btn btn-brown btn-pill" href="<%= user?'/dashboard/membership':'/register' %>">CONVIÉRTASE EN MIEMBRO</a></div>
    <div class="home-categories"><h2>Busque Autos Usados y de Salvamento en copart a la venta</h2><div class="home-category-grid">
      <% var cats=[['Vehículos Wholesale de copart','/vehicles?condition=used','/img/copart/demo-sedan.jpg',[['Sedanes','/vehicles?type=automobile'],['Deportivos','/vehicles?featured=1'],['Automáticos','/vehicles?transmission=automatic'],['Bajo kilometraje','/vehicles?odo_max=50000']]],['Camionetas','/vehicles?type=commercial','/img/copart/demo-suv.jpg',[['Vehículos comerciales','/vehicles?type=commercial'],['Furgonetas','/vehicles?type=van'],['De reparto','/vehicles?type=van'],['Todos los vehículos','/vehicles']]],['SUVs','/vehicles?type=suv','/img/copart/demo-suv.jpg',[['Usados','/vehicles?type=suv&condition=used'],['De salvamento','/vehicles?type=suv&condition=salvage'],['Automáticos','/vehicles?type=suv&transmission=automatic'],['Destacados','/vehicles?type=suv&featured=1']]],['Motocicletas','/vehicles?type=motorcycle','/media/car/motorcycle.svg?view=side',[['Motocicletas','/vehicles?type=motorcycle'],['Modelos recientes','/vehicles?type=motorcycle&sort=year_desc'],['Usadas','/vehicles?type=motorcycle&condition=used'],['De salvamento','/vehicles?type=motorcycle&condition=salvage']]]]; cats.forEach(function(c){ %><article><a class="home-category-tile" href="<%= c[1] %>"><img src="<%= c[2] %>" alt=""><strong><%= c[0] %></strong><span>Buscar Ahora ›</span></a><ul><% c[3].forEach(function(a){ %><li><a href="<%= a[1] %>"><%= a[0] %> ›</a></li><% }) %></ul></article><% }) %>
    </div></div>
  </section>

  <section class="home-promo-row"><a href="/vehicles?condition=used"><span>COMPRE VEHÍCULOS DE</span><strong>VENTA PURA</strong><small>EXPLORAR EL INVENTARIO</small><img src="/img/copart/demo-sedan.jpg" alt="Vehículo ilustrativo"></a><a href="/auctions/calendar"><span>CONSULTE EL</span><strong>CALENDARIO DE SUBASTAS</strong><small>ENCUENTRE SU PRÓXIMA SUBASTA</small><img src="/img/copart/hero-suv-lineup.jpg" alt="Vehículos ilustrativos"></a><a href="/vehicles?sort=bid_asc"><span>SEA EL</span><strong>PRIMERO EN OFERTAR</strong><small>CONSULTE LAS OFERTAS ACTUALES</small><img src="/img/copart/demo-suv.jpg" alt="Vehículo ilustrativo"></a></section>

  <section class="home-follow" aria-labelledby="follow-h"><h2 id="follow-h"><%= ht('Síganos', 'Follow us') %></h2>
    <ul class="social-row"><% [['facebook', 'Facebook'], ['instagram', 'Instagram'], ['tiktok', 'TikTok'], ['linkedin', 'LinkedIn'], ['youtube', 'YouTube']].forEach(function (s) { var url = socialLinks && socialLinks[s[0]]; %>
      <li><% if (url) { %><a href="<%= url %>" target="_blank" rel="noopener noreferrer" aria-label="<%= s[1] %>"><svg class="ic" aria-hidden="true"><use href="#i-soc-<%= s[0] %>"/></svg></a><% } else { %><span aria-label="<%= s[1] %> (<%= ht('sin configurar', 'not configured') %>)" title="<%= ht('Añada el enlace en Administración › Ajustes › social_links', 'Add the link in Administration › Settings › social_links') %>"><svg class="ic" aria-hidden="true"><use href="#i-soc-<%= s[0] %>"/></svg></span><% } %></li><% }) %></ul>
  </section>
</main>
<%- include('../partials/footer') %>
<%- include('../partials/foot',{scripts:['/js/home-reference.js']}) %>
