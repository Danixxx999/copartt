<%- include('../partials/head') %>
<%- include('../partials/header') %>
<% var faqs = [
  ['Who can buy at copart?', 'In this academic demo, any registered member with a Basic or Premium membership and approved identity documents.'],
  ['What does a Guest membership include?', 'Viewing auctions, adding vehicles to the Watchlist and creating vehicle alerts. Guests cannot bid.'],
  ['How do pre-bids (maximum bids) work?', 'You enter the maximum amount you are willing to pay. The system bids on your behalf using the minimum increment needed to keep you in the lead, never above your maximum.'],
  ['What are the bid increments?', 'They depend on the current price (e.g. 25€ under 500€, 50€ up to 2.000€, 100€ up to 10.000€, 250€ above). Administrators can edit the table.'],
  ['What happens when the auction clock reaches zero?', 'The server closes the lot. If the reserve is met it is sold to the highest bidder and an invoice is created. If not, it goes On approval for the seller.'],
  ['How do I pay?', 'Vehicles: bank transfer with receipt upload (validated by Finance). Fees: card in sandbox mode. No real payments are processed.'],
  ['When do I get my pickup PIN?', 'As soon as your invoice is fully paid and approved. It appears in My Purchases. Never share it except at the yard.'],
  ['Can I get the vehicle delivered?', 'Yes. Request a transport quote from your purchase page, accept it, pay it, and track the shipment.'],
  ['How do I cancel a vehicle alert?', 'Use the manage link in the alert email or your dashboard › Vehicle Alerts.'],
  ['Is this the real Copart website?', 'No. copart is an unofficial academic replica built for a university project. All data are fictitious.'],
]; var q = (query.q || '').toLowerCase(); var list = q ? faqs.filter(function (f) { return (f[0] + f[1]).toLowerCase().indexOf(q) >= 0; }) : faqs; %>
<main id="main" class="page-dark">
  <div class="wrap-narrow faq">
    <h1 class="page-title">Common Questions</h1>
    <form class="inline-form" style="width:100%;margin-bottom:16px"><label class="sr-only" for="fq">Search</label><input id="fq" name="q" value="<%= query.q || '' %>" placeholder="Search questions" style="flex:1"><button class="btn btn-blue">Search</button></form>
    <% if (!list.length) { %><div class="empty">No questions match “<%= query.q %>”. <a href="/contact" style="color:var(--blue)">Contact us</a>.</div><% } %>
    <% list.forEach(function (f, i) { %><details <%= i === 0 ? 'open' : '' %>><summary><%= f[0] %></summary><p><%= f[1] %></p></details><% }) %>
  </div>
</main>
<%- include('../partials/footer') %>
<%- include('../partials/foot') %>
