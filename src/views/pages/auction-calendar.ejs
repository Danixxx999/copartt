<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main id="main" class="page-dark" style="padding-left:8px;padding-right:24px">
  <div class="page-head" style="border:0;margin-bottom:4px">
    <div><h1 class="page-title">Auctions Calendar</h1><p style="margin:0;font-size:13px">Announcement: <%= announcement %></p></div>
    <div class="actions"><button class="btn btn-outline btn-sm" style="color:#c7ccd4;border-color:#333" type="button" data-print>Print</button><a class="btn btn-outline btn-sm" style="color:#fff;border-color:#333" href="?view=<%= view === 'list' ? 'calendar' : 'list' %>"><%= view === 'list' ? 'Calendar view' : 'List view' %></a></div>
  </div>
  <div class="cal-layout">
    <div class="cal-wrap">
      <% if (view === 'list') { %>
        <table class="tbl"><thead><tr><th>Date</th><th>Time (Madrid)</th><th>Auction</th><th>Location</th><th class="num">Lots</th><th>Status</th><th></th></tr></thead><tbody>
          <% events.forEach(function (e) { %><tr><td><%= date(e.starts_at) %></td><td><%= time(e.starts_at) %></td><td><%= e.name %></td><td><%= e.location_name || 'All of Spain' %></td><td class="num"><%= e.lots %></td><td><%- badge(e.status) %></td><td><a href="/auctions/<%= e.id %>/live"><%= e.status === 'live' ? 'Join now' : e.status === 'ended' ? 'Results' : 'Sale list' %></a></td></tr><% }) %>
          <% if (!events.length) { %><tr><td colspan="7" class="empty">No auctions scheduled.</td></tr><% } %>
        </tbody></table>
      <% } else { %>
      <table class="cal">
        <% weeks.forEach(function (w) { %>
          <tr><th>Auction Time<br>(CET – Madrid)</th><% w.days.forEach(function (d) { %><th><%= d.label %><br><%= d.date %></th><% }) %></tr>
          <% if (!w.times.length) { %><tr><td></td><% w.days.forEach(function () { %><td></td><% }) %></tr><% } %>
          <% w.times.forEach(function (tm) { %><tr><td><%= tm %></td><% w.days.forEach(function (d) { %><td class="<%= d.today ? 'today' : '' %>"><% d.events.filter(function (e) { return time(e.starts_at) === tm; }).forEach(function (e) { %><div class="ev <%= e.status === 'ended' ? 'past' : '' %>"><a href="/auctions/<%= e.id %>/live" title="<%= e.lots %> lots · <%= label(e.status) %>"><%= e.name %></a></div><% }) %></td><% }) %></tr><% }) %>
        <% }) %>
      </table>
      <% } %>
    </div>
    <aside class="side-box">
      <h2>Auction calendar</h2>
      <p>Find the next vehicle auctions using the copart Auction Calendar.</p>
      <p>You can view the calendar in several different ways, the view as a calendar or the view as a list. We recommend you use the view as a list if you prefer to order the auctions by date, time or location. The calendar view is excellent if you want to quickly see all the auctions that take place on a specific day. Times are shown in <strong>Madrid time (CET/CEST)</strong>; the server clock decides when each auction starts.</p>
      <p><a href="/auctions">Join an auction now ›</a></p>
    </aside>
  </div>
</main>
<%- include('../partials/footer') %>
<%- include('../partials/foot') %>
