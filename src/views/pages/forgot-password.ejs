<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main id="main" class="page-dark">
  <div style="max-width:420px;margin:0 auto">
    <h1 class="page-title"><%= token ? 'Choose a new password' : 'Forgot Password?' %></h1>
    <div class="login-card"><% if (token) { %>
      <form data-api="/api/v1/auth/reset-password" novalidate><input type="hidden" name="token" value="<%= token %>">
        <div class="form-row"><label for="np">New password</label><input id="np" name="password" type="password" autocomplete="new-password" required><span class="hint">Min. 10 characters with letters and numbers.</span></div>
        <button class="btn btn-blue btn-block" type="submit">Save password</button></form>
    <% } else { %>
      <form data-api="/api/v1/auth/forgot-password" data-reset novalidate>
        <p class="hint">Enter your email and we'll send you a reset link (demo: the email appears in Admin › Demo mailbox).</p>
        <div class="form-row"><label for="fe">Email</label><input id="fe" name="email" type="email" autocomplete="email" required></div>
        <button class="btn btn-blue btn-block" type="submit">Send reset link</button></form>
    <% } %><div class="new"><a href="/login">Back to Sign In</a></div></div>
  </div>
</main>
<%- include('../partials/footer', { hideCta: true }) %>
<%- include('../partials/foot') %>
