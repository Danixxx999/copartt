<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main id="main" class="page-dark">
  <div class="wrap">
    <div class="crumbs"><a href="/">Home</a> › <a href="/locations">Locations</a> › <%= loc.name %></div>
    <h1 class="page-title"><%= loc.name %></h1>
    <div class="grid-2" style="margin:20px 0 30px">
      <div class="card-dark">
        <dl class="spec-list">
          <dt>Address</dt><dd><%= loc.address %>, <%= loc.postal_code %> <%= loc.city %> (<%= loc.province %>)</dd>
          <dt>Phone</dt><dd><%= loc.phone %></dd><dt>Email</dt><dd><%= loc.email %></dd>
          <dt>Office hours</dt><dd><%= loc.hours %></dd><dt>Pickup hours</dt><dd><%= loc.pickup_hours %></dd>
          <dt>Vehicles for sale</dt><dd><%= lots.total %></dd>
        </dl>
        <p class="hint" style="margin-top:12px"><%= loc.description %></p>
        <div class="actions"><a class="btn btn-blue" href="/vehicles?location=<%= loc.code %>">View vehicles at this yard</a><a class="btn btn-outline" style="color:#fff" href="/transport">Request transport</a></div>
      </div>
      <div class="map-box" role="img" aria-label="Approximate map position of the yard">
        <svg viewBox="0 0 400 300"><path d="M60 70 L160 40 L300 50 L360 110 L330 200 L250 260 L130 250 L70 190 Z" fill="#1b3a66" stroke="#3b6bc4" stroke-width="2"/><% var x = 60 + (Number(loc.lng) + 9.5) / 13 * 300, y = 260 - (Number(loc.lat) - 36) / 8 * 220; %><circle cx="<%= x %>" cy="<%= y %>" r="9" fill="#f6a35b"/><text x="<%= x + 12 %>" y="<%= y + 4 %>" fill="#fff" font-size="14"><%= loc.city %></text><text x="12" y="290" fill="#9aa4b2" font-size="11">Schematic map (demo) · <%= loc.lat %>, <%= loc.lng %></text></svg>
      </div>
    </div>
    <h2 style="font-size:20px">Upcoming auctions with vehicles from this yard</h2>
    <% if (!events.length) { %><p class="muted">None scheduled.</p><% } else { %><ul class="history" style="margin-bottom:30px"><% events.forEach(function (e) { %><li><a href="/auctions/<%= e.id %>/live" style="color:var(--blue)"><%= e.name %></a><span><%= dateTime(e.starts_at) %></span></li><% }) %></ul><% } %>
    <h2 style="font-size:20px">Vehicles at this yard</h2>
    <div class="results-grid"><% lots.items.forEach(function (l) { %><%- include('../partials/lot-card', { l: l }) %><% }) %></div>
  </div>
</main>
<%- include('../partials/footer') %>
<%- include('../partials/foot') %>
