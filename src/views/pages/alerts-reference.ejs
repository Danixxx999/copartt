<%- include('../partials/head') %><%- include('../partials/header') %>
<main id="main" class="portal-alerts inventory-guide">
 <section class="vehicle-alert-hero"><div><h1>Alerta de Vehículos</h1><h2>Reciba notificaciones sobre nuevos vehículos de copart</h2></div></section>
 <section class="vehicle-alert-grid">
 <div><% if(alert){ %><h2>Gestionar mi alerta</h2><p>Estado: <%- badge(alert.status) %> · <%= alert.matches %> coincidencias · Creada el <%= date(alert.created_at) %></p><% if(alert.status==='active'){ %><button class="btn btn-red" type="button" data-api="/api/v1/alerts/<%= alert.manage_token %>/cancel" data-confirm="¿Cancelar esta alerta? Dejará de recibir avisos.">Cancelar alerta</button><% } %><h3>Vehículos que coinciden</h3><% if(!matches.length){ %><p>No hay coincidencias todavía.</p><% }else{ %><ul><% matches.forEach(l=>{ %><li><a href="/lot/<%= l.lot_number %>"><%= lotTitle(l) %> · Lote #<%= l.lot_number %></a></li><% }) %></ul><% } %><a href="/vehicle-alerts">Crear otra alerta ›</a>
 <% }else{ %><h2>¿No consigue el vehículo que quiere? Regístrese para recibir las Alertas de los Vehículos copart.</h2><p>Las alertas le avisan por correo electrónico de los vehículos que agregamos al inventario y que cumplen sus criterios.</p><p>Puede cambiar la frecuencia o cancelar sus alertas en cualquier momento desde su cuenta o mediante el enlace de gestión del aviso.</p><p>Seleccione el vehículo que busca, el rango de años y la frecuencia. Confirme su consentimiento para activar la alerta.</p><% if(isMemberPortal){ %><a href="/dashboard/alerts">Gestionar todas mis alertas ›</a><% } %><p class="hint">En esta demostración, los mensajes se guardan en el buzón de prueba de copart.</p><% } %></div>
 <form class="vehicle-alert-form" data-api="/api/v1/alerts<%= alert?'/'+alert.manage_token:'' %>" data-method="<%= alert?'PATCH':'POST' %>" <%= alert&&alert.status!=='active'?'hidden':'' %>>
 <label class="sr-only" for="a-channel">Tipo de alerta</label><select id="a-channel" aria-label="Tipo de alerta"><option>Avisos por correo electrónico</option></select>
 <label class="sr-only" for="a-type">Tipo de vehículo</label><select id="a-type" name="vehicle_type"><option value="">Todos los tipos de vehículo</option><% types.forEach(v=>{ %><option value="<%= v.code %>" <%= alert&&alert.type_code===v.code?'selected':'' %>><%= v.name %></option><% }) %></select>
 <div class="alert-year-range"><label class="sr-only" for="a-from">Año desde</label><select id="a-from" name="year_from"><% for(var y=new Date().getFullYear()+1;y>=1920;y--){ %><option value="<%= y %>" <%= (alert?alert.year_from:2016)===y?'selected':'' %>><%= y %></option><% } %></select><span>hasta</span><label class="sr-only" for="a-to">Año hasta</label><select id="a-to" name="year_to"><% for(var y=new Date().getFullYear()+1;y>=1920;y--){ %><option value="<%= y %>" <%= (alert?alert.year_to:new Date().getFullYear())===y?'selected':'' %>><%= y %></option><% } %></select></div>
 <label class="sr-only" for="a-make">Marca</label><select id="a-make" name="make_id" data-make-select data-target="a-model" required><option value="">Seleccione una marca</option><% makes.forEach(m=>{ %><option value="<%= m.id %>" data-id="<%= m.id %>" <%= alert&&alert.make_id===m.id?'selected':'' %>><%= m.name %></option><% }) %></select>
 <label class="sr-only" for="a-model">Modelo</label><select id="a-model" name="model_id" data-placeholder="Seleccione modelo" data-selected="<%= alert?alert.model_id||'':'' %>" required><option value="">Seleccione modelo</option></select>
 <label class="sr-only" for="a-freq">Frecuencia</label><select id="a-freq" name="frequency" required><option value="">Frecuencia</option><% [['instant','Al incorporarse al inventario'],['daily','Diaria'],['weekly','Semanal']].forEach(f=>{ %><option value="<%= f[0] %>" <%= alert&&alert.frequency===f[0]?'selected':'' %>><%= f[1] %></option><% }) %></select>
 <label for="a-fn">Nombre<input id="a-fn" name="first_name" value="<%= alert?alert.first_name:user?user.first_name:'' %>" required maxlength="60" autocomplete="given-name"></label>
 <label for="a-ln">Apellido<input id="a-ln" name="last_name" value="<%= alert?alert.last_name:user?user.last_name:'' %>" required maxlength="80" autocomplete="family-name"></label>
 <label for="a-em">Correo electrónico<input id="a-em" name="email" type="email" value="<%= alert?alert.email:user?user.email:'' %>" required autocomplete="email"></label>
 <% if(!alert){ %><label class="alert-consent"><input type="checkbox" name="consent" required> Acepto recibir avisos de vehículos por correo electrónico. Puedo cancelar la alerta desde su enlace de gestión.</label><% } %>
 <div class="alert-form-actions"><button class="btn btn-blue" type="submit"><%= alert?'Guardar cambios':'Registrarse' %></button></div>
 </form></section>
 <section class="alert-how"><div><svg class="ic" aria-hidden="true"><use href="#i-bell"/></svg><h2>1. Elija su vehículo<br>2. Active su alerta<br>3. Revise las coincidencias</h2><a class="btn btn-blue" href="/vehicle-finder">Buscar vehículos ahora</a></div><h2>Es la forma más fácil de recibir notificaciones cuando sus vehículos favoritos se agregan a nuestro inventario.</h2></section>
</main><%- include('../partials/footer') %><%- include('../partials/foot') %>
