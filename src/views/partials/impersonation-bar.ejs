<% if (typeof impersonator !== 'undefined' && impersonator && user) { %>
<div class="imp-bar" role="alert">
  <svg class="ic" aria-hidden="true"><use href="#i-shield"/></svg>
  <span>Estás actuando como <strong><%= user.name %></strong> (<%= user.email %>) · iniciado por el administrador <%= impersonator.email %>. Toda acción queda registrada en la auditoría.</span>
  <button type="button" class="btn btn-sm btn-dark" data-api="/api/v1/auth/impersonation/stop">Volver a mi cuenta</button>
</div>
<% } %>
