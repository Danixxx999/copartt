<% if(path === '/dashboard/lots') { var actions=[['Mis Lotes','/dashboard/lots'],['Mis ofertas','/dashboard/bids'],['Mis Contraofertas','/dashboard/bids?tab=counter'],['Lotes ganados','/dashboard/bids?tab=won'],['Pagos adeudados','/dashboard/payments'],['Títulos','/dashboard/purchases'],['Lotes para ser Recogidos','/dashboard/purchases'],['Historial del lote','/dashboard/bids?tab=lost']]; %>
<div class="action-sidebar"><h3>Lista de Acción</h3><button class="collapse-actions" type="button" data-collapse-sidebar aria-label="Contraer lista de acción">❮</button><ul><% actions.forEach(function(a,i){ %><li><a href="<%= a[1] %>" class="<%= i===0?'selected':'' %>"><span class="radio-dot"></span><%= a[0] %></a></li><% }) %></ul><h3>Opciones de filtro</h3><div class="sidebar-filter">⊟ <button type="button" data-clear-filters>Borrar todos</button></div><div class="sidebar-filter">⊟ <button type="button" data-clear-filters>Borrar</button></div></div>
<% } else { var links=[['Todas las ofertas','/dashboard/bids'],['Ofertas actuales','/dashboard/bids'],['Ganador','/dashboard/bids?tab=won'],['No ganador','/dashboard/bids?tab=lost'],['Artículos abiertos','/dashboard/lots'],['Mis Ofertas','/dashboard/bids?tab=counter']]; %>
<div class="bid-sidebar"><h3>Menú</h3><ul><% links.forEach(function(a){ %><li><a href="<%= a[1] %>"><%= a[0] %><b>❯</b></a></li><% }) %></ul></div>
<% } %>
