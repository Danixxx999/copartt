<% if(referenceLayout && !isMemberPortal) { var en=lang==='en'; %>
<section class="cookie-banner" data-cookie-banner <%= cookieChoice?'hidden':'' %> aria-label="<%= en?'Cookie preferences':'Preferencias de cookies' %>"><p><%= en?'We use essential cookies for sign-in and security. Save your preference for optional cookies; no advertising trackers are active in this demo.':'Usamos cookies necesarias para iniciar sesión y proteger la cuenta. Puede guardar su preferencia sobre cookies opcionales; esta demo no activa rastreadores publicitarios.' %> <a href="/page/cookie-policy"><%= en?'Cookie Policy':'Política de cookies' %></a></p><div class="cookie-actions"><button type="button" class="cookie-settings" data-cookie-settings><%= en?'Cookies Settings':'Configurar cookies' %></button><button type="button" data-cookie-choice="reject"><%= en?'Reject All':'Rechazar opcionales' %></button><button type="button" data-cookie-choice="accept"><%= en?'Accept All Cookies':'Aceptar todas' %></button><button type="button" class="cookie-close" data-cookie-choice="reject" aria-label="<%= en?'Close cookie banner':'Cerrar aviso de cookies' %>">×</button></div></section>
<dialog class="cookie-dialog" data-cookie-dialog><h2><%= en?'Cookie preferences':'Preferencias de cookies' %></h2><p><%= en?'Essential cookies keep your session secure and cannot be disabled here. Optional preferences do not enable any external trackers in this demonstration.':'Las cookies necesarias mantienen su sesión segura y no se pueden desactivar aquí. Las preferencias opcionales no activan rastreadores externos en esta demostración.' %></p><form data-cookie-form><label><input type="checkbox" checked disabled> <%= en?'Essential (always active)':'Necesarias (siempre activas)' %></label><label><input type="checkbox" name="analytics"> <%= en?'Analytics preference':'Preferencia de analítica' %></label><label><input type="checkbox" name="marketing"> <%= en?'Marketing preference':'Preferencia de marketing' %></label><button class="btn" type="submit"><%= en?'Save preferences':'Guardar preferencias' %></button></form></dialog>
<% } %>
